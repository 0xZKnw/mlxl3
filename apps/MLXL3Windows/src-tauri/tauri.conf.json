{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MLXL3 Desktop",
  "mainBinaryName": "MLXL3",
  "version": "0.0.0",
  "identifier": "tech.0xzknw.mlxl3.windows",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MLXL3",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "MLXL3",
    "shortDescription": "Local EXL3 chat on NVIDIA and AMD GPUs",
    "copyright": "MIT License",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": {
      "../../../engines/exl3/mlxl3_exl3/": "engine/mlxl3_exl3/",
      "../../../engines/exl3/runtime/": "runtime/",
      "bin/": "bin/",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
