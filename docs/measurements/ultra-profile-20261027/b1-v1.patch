+pub(crate) fn validate_readback_sample(raw: [u64; 8], bytes: usize) -> Result<ReadbackSample> {
+    ensure!(
+        raw[0] == 1 && raw[5] <= 1 && raw[6] <= 1,
+        "invalid readback sample flags"
+    );
+    ensure!(
+        u64::try_from(bytes).ok() == Some(raw[4]),
+        "readback sample byte count differs"
+    );
+    let measured = raw[1]
+        .checked_add(raw[2])
+        .and_then(|sum| sum.checked_add(raw[3]));
+    ensure!(
+        measured.is_some_and(|sum| sum <= raw[7]),
+        "invalid readback sample durations"
+    );
+    ensure!(
+        raw[6] == 0 || raw[3] == 0,
+        "direct readback unexpectedly built a copy"
+    );
+    Ok(ReadbackSample {
+        wait_ns: raw[1],
+        copy_ns: raw[2],
+        contiguous_build_ns: raw[3],
+        bytes: raw[4],
+        ready_before: raw[5] == 1,
+        direct: raw[6] == 1,
+        total_ns: raw[7],
+    })
+}
