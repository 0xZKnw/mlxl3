+#[cfg(kani)]
+#[kani::proof]
+#[kani::unwind(10)]
+fn output_blocks_keep_every_tile_and_token_inside_vocabulary() {
+    let blocks: [u32; 8] = kani::any();
+    let length: usize = kani::any();
+    if length > blocks.len() {
+        return;
+    }
+    let blocks = &blocks[..length];
+    let vocab: i32 = kani::any();
+    let valid = valid_output_blocks(blocks, vocab);
+    if valid {
+        assert!(vocab > 128 && vocab % 128 == 0 && !blocks.is_empty());
+        assert!(length * 128 < vocab as usize);
+        for (index, &block) in blocks.iter().enumerate() {
+            assert!(block * 128 + 127 < vocab as u32);
+            assert!(block * 8 + 7 < (vocab / 16) as u32);
+            if index > 0 {
+                assert!(blocks[index - 1] < block);
+            }
+        }
+    }
+    kani::cover!(valid && length == 1);
+    kani::cover!(valid && length == 8);
+    kani::cover!(!valid && length == 0);
+    kani::cover!(!valid && length > 0 && blocks[0] == u32::MAX);
+}
 
