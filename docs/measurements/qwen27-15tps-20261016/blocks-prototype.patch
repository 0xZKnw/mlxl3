+    fn exl3_output_map_loader_is_bounded_and_rejects_incompatible_metadata() -> Result<()> {
+        let dir = tempfile::tempdir()?;
+        let path = dir.path().join("draft_head_exl3.json");
+        assert!(read_output_blocks(&path, 128, 512, false)?.is_none());
+        let valid = serde_json::json!({"input":128,"vocab":512,"blocks":[0,2]});
+        std::fs::write(&path, serde_json::to_vec(&valid)?)?;
+        assert_eq!(
+            read_output_blocks(&path, 128, 512, false)?,
+            Some(vec![0, 2])
+        );
+        assert!(read_output_blocks(&path, 256, 512, false).is_err());
+        assert!(read_output_blocks(&path, 128, 1024, false).is_err());
+        assert!(read_output_blocks(&path, 128, 512, true).is_err());
+        for (field, value) in [
+            ("input", serde_json::json!(0)),
+            ("input", serde_json::json!(true)),
+            ("vocab", serde_json::json!(i32::MAX)),
+            ("blocks", serde_json::json!([])),
+            ("blocks", serde_json::json!([0, 1, 2, 3])),
+            ("blocks", serde_json::json!([2, 0])),
+            ("blocks", serde_json::json!([2, 2])),
+            ("blocks", serde_json::json!([4])),
+            ("blocks", serde_json::json!([u32::MAX])),
+            ("blocks", serde_json::json!([-1])),
+            ("blocks", serde_json::json!([false])),
+            ("blocks", serde_json::json!([0.5])),
+            ("blocks", serde_json::json!(null)),
+            ("extra", serde_json::json!(0)),
+        ] {
+            let mut bad = valid.clone();
+            bad[field] = value;
+            std::fs::write(&path, serde_json::to_vec(&bad)?)?;
+            assert!(
+                read_output_blocks(&path, 128, 512, false).is_err(),
+                "{field}: {bad}"
+            );
+        }
+        for bytes in [b"{".as_slice(), b"null", b"[]", b"{}"] {
+            std::fs::write(&path, bytes)?;
+            assert!(read_output_blocks(&path, 128, 512, false).is_err());
+        }
+        let mut bytes = serde_json::to_vec(&valid)?;
+        bytes.resize(2 * 1024 * 1024, b' ');
+        std::fs::write(&path, &bytes)?;
+        assert_eq!(
+            read_output_blocks(&path, 128, 512, false)?,
+            Some(vec![0, 2])
+        );
+        bytes.push(b' ');
+        std::fs::write(&path, &bytes)?;
+        assert!(read_output_blocks(&path, 128, 512, false).is_err());
+        std::fs::remove_file(&path)?;
+        std::fs::create_dir(&path)?;
+        assert!(read_output_blocks(&path, 128, 512, false).is_err());
+        Ok(())
+    }
