 //! Checked arithmetic shared by checkpoint and GPU-facing production paths.
+
+#[cfg(any(feature = "mlx", test, kani))]
+pub(crate) fn valid_output_blocks(blocks: &[u32], vocab: i32) -> bool {
+    vocab > 128
+        && vocab % 128 == 0
+        && !blocks.is_empty()
+        && blocks.len() < (vocab / 128) as usize
+        && blocks.iter().all(|&block| block < (vocab / 128) as u32)
+        && blocks.windows(2).all(|pair| pair[0] < pair[1])
+}
+
+#[test]
+fn output_blocks_require_complete_ordered_strict_subset() {
+    assert!(valid_output_blocks(&[0, 2], 512));
+    assert!(valid_output_blocks(&[0], 256));
+    assert!(valid_output_blocks(&[16_777_214], 2_147_483_520));
+    for (blocks, vocab) in [
+        (&[][..], 512),
+        (&[0, 1][..], 256),
+        (&[1, 0][..], 512),
+        (&[0, 0][..], 512),
+        (&[4][..], 512),
+        (&[u32::MAX][..], 512),
+        (&[0][..], 0),
+        (&[0][..], -128),
+        (&[0][..], 128),
+        (&[0][..], i32::MAX),
+        (&[0][..], 511),
+    ] {
+        assert!(!valid_output_blocks(blocks, vocab));
+    }
+}
