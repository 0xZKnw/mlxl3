 //! Checked arithmetic shared by checkpoint and GPU-facing production paths.
 
+#[cfg(any(feature = "mlx", test, kani))]
+pub(crate) fn exl3_prefill_tile_rows(width: u32) -> Option<u32> {
+    (2..=4).contains(&width).then_some(width)
+}
+
+#[test]
+fn prefill_tile_widths_preserve_thread_and_shared_memory_bounds() {
+    for width in 0..=80 {
+        let actual = exl3_prefill_tile_rows(width);
+        assert_eq!(
+            actual,
+            [None, None, Some(2), Some(3), Some(4)]
+                .get(width as usize)
+                .copied()
+                .flatten()
+        );
+        if let Some(rows) = actual {
+            assert!(rows * 128 <= 512);
+            assert!(rows * 4 * 256 * 4 + 4 * 256 * 4 <= 20 * 1024);
+        }
+    }
+}
+
+#[cfg(kani)]
+#[kani::proof]
+fn exl3_prefill_tile_has_bounded_threadgroups() {
+    let width: u32 = kani::any();
+    let result = exl3_prefill_tile_rows(width);
+    assert_eq!(result.is_some(), width == 2 || width == 3 || width == 4);
+    if let Some(rows) = result {
+        assert_eq!(rows, width);
+        assert!(rows * 128 <= 512);
+        assert!(rows * 4 * 256 * 4 + 4 * 256 * 4 <= 20 * 1024);
+    }
+    kani::cover!(result == Some(4));
+    kani::cover!(result == Some(2));
+    kani::cover!(result.is_none());
+}
+
