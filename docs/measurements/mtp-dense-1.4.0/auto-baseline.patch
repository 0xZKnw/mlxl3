+#[cfg(all(feature = "mlx", feature = "chat"))]
+fn load_mtp_head(
+    head: &mut Option<(PathBuf, mlxl3_native::mtp::Head)>,
+    revision: &mut Option<String>,
+    prompt_cache: &mut Option<PromptCache>,
+    requested: &str,
+    target: &mlxl3_native::qwen35::Qwen35Moe,
+) -> Result<bool> {
