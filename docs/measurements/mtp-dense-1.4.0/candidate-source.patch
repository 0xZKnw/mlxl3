+#[kani::proof]
+fn managed_mtp_never_crosses_architectures() {
+    let layout = Layout {
+        hidden_size: kani::any(),
+        num_attention_heads: kani::any(),
+        num_key_value_heads: kani::any(),
+        head_dim: kani::any(),
