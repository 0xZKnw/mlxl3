+  catch (const std::invalid_argument&) { rejected = true; }
+  __CPROVER_assert(rejected == (start < 8 || length == 0), "pending destinations are disjoint");
+  for (auto byte : bank) __CPROVER_assert(byte == 0, "preparation performs no writes");
