+    pub(crate) fn forward_pair(&self, x: &Array) -> Result<[Array; 2]> {
+        ensure!(
+            x.shape() == [2, self.logical_input]
+                && matches!(x.dtype(), Dtype::Float16 | Dtype::Float32),
+            "paired projection expects two floating-point rows"
+        );
+        if let ProjectionWeights::Dense(weight) = &self.weights
+            && weight.dtype() == Dtype::Float16
+            && x.dtype() == Dtype::Float32
+        {
+            // Share MLX's promotion while keeping both original mono-row GEMVs.
+            let weight = weight.transpose(&[1, 0])?.astype(Dtype::Float32)?;
+            let project = |row| -> Result<Array> {
+                let value = x.slice(0, row, row + 1)?.matmul(&weight)?;
+                match &self.bias {
+                    Some(bias) => value.add(bias),
+                    None => Ok(value),
+                }
+            };
+            Ok([project(0)?, project(1)?])
+        } else {
+            Ok([
+                self.forward(&x.slice(0, 0, 1)?)?,
+                self.forward(&x.slice(0, 1, 2)?)?,
+            ])
+        }
+    }
