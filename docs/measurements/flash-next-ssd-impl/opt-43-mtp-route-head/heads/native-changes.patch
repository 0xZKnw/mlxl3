+    #[test]
+    #[ignore = "physical Apple GPU and full Flash head; exact joint evaluation and component timing"]
+    fn flash_joint_head_preserves_full_logits_and_single_evaluation() -> Result<()> {
+        let c = crate::checkpoint::inspect(Path::new(&std::env::var("MLXL3_FLASH_MODEL")?))?;
+        let mut model = FlashNext::from_checkpoint(&c)?;
+        model.forward(EOS)?;
+        let first = model
+            .last_hidden
+            .as_ref()
+            .context("missing hidden")?
+            .try_clone()?;
+        model.forward(7)?;
+        let second = model
+            .last_hidden
+            .as_ref()
+            .context("missing hidden")?
+            .try_clone()?;
+        first.eval()?;
+        second.eval()?;
+        let strided = |value: &Array| -> Result<Array> {
+            let values = value.to_f32()?;
+            Array::from_f32(
+                &values.into_iter().flat_map(|v| [v, 0.]).collect::<Vec<_>>(),
+                &[WIDTH, 2],
+            )?
+            .slice(1, 0, 1)?
+            .transpose(&[1, 0])
+        };
+        let cases = [
+            [first.try_clone()?, second.try_clone()?],
+            [Array::zeros(&[1, WIDTH])?, Array::zeros(&[1, WIDTH])?],
+            [strided(&first)?, strided(&second)?],
+            [
+                Array::from_f32(
+                    &(0..WIDTH)
+                        .map(|i| ((i % 7) - 3) as f32 / 1024.)
+                        .collect::<Vec<_>>(),
+                    &[1, WIDTH],
+                )?,
+                Array::from_f32(
+                    &(0..WIDTH)
+                        .map(|i| ((i % 11) - 5) as f32 / 1024.)
+                        .collect::<Vec<_>>(),
+                    &[1, WIDTH],
+                )?,
+            ],
+        ];
+        let mut checked = 0;
+        for (case, streams) in cases.iter().enumerate() {
+            for stream in streams {
+                stream.eval()?;
+            }
+            let before = Array::eval_calls_for_test();
+            let expected = Array::concatenate(
+                &[&model.logits(&streams[0])?, &model.logits(&streams[1])?],
+                0,
+            )?;
+            ensure!(Array::eval_calls_for_test() - before == 2);
+            let before = Array::eval_calls_for_test();
+            let actual = model.logits_pair(streams)?;
+            ensure!(
+                Array::eval_calls_for_test() - before == 1,
+                "head pair did not share evaluation"
+            );
+            let values = actual.to_f32()?;
+            ensure!(
+                actual.shape() == [2, 248320]
+                    && actual.dtype() == expected.dtype()
+                    && values.len() == 496640
+                    && values.iter().all(|v| v.is_finite())
+            );
+            ensure!(
+                actual.to_bytes()? == expected.to_bytes()?,
+                "joint head logits differ"
+            );
+            let ids = actual.chat_greedy_ids()?;
+            ensure!(
+                ids.len() == 2
+                    && ids.iter().all(|&i| i < 248320)
+                    && ids == expected.chat_greedy_ids()?
+            );
+            if case == 1 {
+                ensure!(ids == [0, 0], "zero-logit tie oracle differs");
+            }
+            checked += values.len();
+        }
+        ensure!(checked == 1986560);
+        for invalid in [
+            Array::zeros(&[0, WIDTH])?,
+            Array::zeros(&[2, WIDTH])?,
+            Array::zeros(&[1, WIDTH - 1])?,
+            Array::zeros(&[1, 1, WIDTH])?,
+            first.astype(Dtype::Float16)?,
+        ] {
+            let before = Array::eval_calls_for_test();
+            ensure!(model.logits_pair(&[invalid, second.try_clone()?]).is_err());
+            ensure!(
+                Array::eval_calls_for_test() == before,
+                "invalid pair evaluated a head"
+            );
+        }
+        let streams = [first, second];
+        let run = |joint| -> Result<()> {
+            let logits = if joint {
+                model.logits_pair(&streams)?
+            } else {
+                Array::concatenate(
+                    &[&model.logits(&streams[0])?, &model.logits(&streams[1])?],
+                    0,
+                )?
+            };
+            let ids = logits.chat_greedy_ids()?;
+            ensure!(ids.len() == 2);
+            std::hint::black_box(ids);
+            Ok(())
+        };
+        for _ in 0..2 {
+            run(false)?;
+            run(true)?;
+        }
+        let mut blocks = Vec::new();
+        for block in 0..5 {
+            let mut times = [0.; 2];
+            for joint in if block % 2 == 0 {
+                [false, true]
+            } else {
+                [true, false]
+            } {
+                let start = std::time::Instant::now();
+                for _ in 0..16 {
+                    run(joint)?;
+                }
+                times[usize::from(joint)] = start.elapsed().as_secs_f64() / 16.;
+            }
+            ensure!(times.iter().all(|v| v.is_finite() && *v > 0.));
+            blocks.push(serde_json::json!({"original":times[0],"joint":times[1],"order":if block%2==0 { ["original","joint"] } else { ["joint","original"] }}));
+        }
+        let memory = crate::array::memory_stats(false)?;
+        ensure!(
+            memory
+                .process_lifetime_peak_bytes
+                .is_some_and(|p| p > 0 && p <= 10 << 30)
+        );
+        println!(
+            "MTP43_HEAD_PAIR {}",
+            serde_json::json!({"status":"passed_exact_head_components","checked_logits":checked,"head_rows":2,"input_cases":4,"blocks":blocks,"memory":memory,"limits":"materialized inputs, unchanged mono-row graphs and same log_probs/argmax consumer; component wall-clock, not release throughput"})
+        );
+        Ok(())
+    }
