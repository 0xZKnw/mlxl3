+// Same selection contract as the legacy rank kernel, with bounded SIMD merges.
+fn top10_simd(values: &Array, normalize: bool) -> Result<(Array, Array)> {
+    ensure!(
+        values.shape().len() == 2
+            && (1..=2).contains(&values.shape()[0])
+            && values.shape()[1] == 512
+            && matches!(values.dtype(), Dtype::Float16 | Dtype::Float32),
+        "SIMD top10 requires one or two floating-point rows of 512 experts"
+    );
+    let rows = values.shape()[0];
+    let arithmetic = if values.dtype() == Dtype::Float32 {
+        "float"
+    } else {
+        "half"
+    };
+    let mut out = array::metal_kernel(
+        &format!(
+            "mlxl3_flash_top10_simd_{arithmetic}_n{}",
+            u8::from(normalize)
+        ),
+        &["values"],
+        &["indices", "scores"],
+        &format!(
+            "#define ARITH {arithmetic}\n#define NORMALIZE {}\n",
+            u8::from(normalize)
+        ),
+        include_str!("../shaders/flash_top10.metal"),
+        &[values],
+        &[vec![rows, 10], vec![rows, 10]],
+        &[Dtype::UInt32, values.dtype()],
+        [512, rows, 1],
+        [512, 1, 1],
+    )?;
+    ensure!(out.len() == 2, "invalid top10 output count");
+    let scores = out.pop().context("missing top10 scores")?;
+    let indices = out.pop().context("missing top10 indices")?;
     Ok((indices, scores))
 }
 
