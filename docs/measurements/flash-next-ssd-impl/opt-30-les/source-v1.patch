+    fn prefetch(&mut self, ids: &[u32]) -> Result<()> {
+        self.drain()?;
+        let routes = match self.cache.prefetch(ids) {
+            Ok(routes) => routes,
+            Err(CacheError::Capacity) => return Ok(()),
+            Err(error) => return Err(error.into()),
+        };
+        let mut filled = BTreeSet::new();
+        let jobs = ids
+            .iter()
+            .zip(routes)
+            .filter_map(|(&id, (slot, hit))| (!hit && filled.insert(slot)).then_some((id, slot)))
+            .collect::<Vec<_>>();
+        if self.fill_many(&jobs).is_err() {
+            // A prediction is optional; failed fills must become ordinary demand misses.
+            self.cache.invalidate();
+        } else {
+            #[cfg(test)]
+            {
+                self.prefetched += jobs.len() as u64;
+            }
+        }
+        Ok(())
