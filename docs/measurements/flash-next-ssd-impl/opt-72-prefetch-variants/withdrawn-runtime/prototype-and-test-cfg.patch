+#[cfg(test)]
+#[test]
+fn prefetch_variants_and_protection_reject_unrequested_work() {
+    let names = [
+        ("legacy", PrefetchVariant::Legacy),
+        ("late", PrefetchVariant::Late),
+        ("bounded", PrefetchVariant::Bounded),
+        ("unused", PrefetchVariant::Unused),
+        ("lfu", PrefetchVariant::Lfu),
+        ("weighted", PrefetchVariant::Weighted),
+        ("packed", PrefetchVariant::Packed),
+    ];
+    for (name, expected) in names {
+        assert_eq!(PrefetchVariant::parse(name), Some(expected));
+        assert!(PrefetchVariant::parse(&format!("{name} ")).is_none());
+        assert!(PrefetchVariant::parse(&format!("{name}\0")).is_none());
+    }
+    for bad in ["", "1", "true", "Late", "all", "lfu,late"] {
+        assert!(PrefetchVariant::parse(bad).is_none());
+    }
+    assert_eq!(
+        PrefetchVariant::parse("legacy"),
+        Some(PrefetchVariant::default())
