+    for ids in [0, 1, 2, 4, 16, 32, usize::MAX] {
+        for budget in [0, 1, 2, 4, 10, usize::MAX] {
+            let expected = (0..4).filter(|&i| i < ids && i < budget).count();
+            assert_eq!(prediction_protection_len(ids, budget, true), expected);
+            assert_eq!(prediction_protection_len(ids, budget, false), 0);
+        }
+    }
+}
