+#[test]
+#[ignore = "physical Apple GPU and real Flash router weights; run alone"]
+fn pooled_predictions_match_independent_probability_sums() -> Result<()> {
+    let (moe, x) = super::tests::resident_gate_fixture()?.remove(0);
+    let x = Array::concatenate(&[&x[0], &x[1]], 0)?;
+    let scores = moe.gate.forward(&x)?;
+    let probabilities = scores.softmax_precise()?.to_f32()?;
+    ensure!(probabilities.len() == 1024 && probabilities.iter().all(|p| p.is_finite()));
+    let sums = (0..512)
+        .map(|i| probabilities[i] + probabilities[512 + i])
+        .collect::<Vec<_>>();
+    let ids = moe.predict_with_pooling(&x, true)?.to_u32()?;
+    ensure!(ids.len() == 16 && ids.iter().all(|&id| id < 512));
+    let unique = ids
+        .iter()
+        .copied()
+        .collect::<std::collections::BTreeSet<_>>();
+    ensure!(unique.len() == 16);
+    let minimum = ids
+        .iter()
+        .map(|&id| sums[id as usize])
+        .fold(f32::INFINITY, f32::min);
+    ensure!(
+        (0..512)
+            .filter(|id| !unique.contains(id))
+            .all(|id| sums[id as usize] <= minimum)
+    );
+    ensure!(
+        ids.windows(2)
+            .all(|pair| sums[pair[0] as usize] <= sums[pair[1] as usize])
+    );
+    println!("POOLED_PREDICTIONS rows=2 unique=16 cpu_sum_oracle=true");
+    Ok(())
+}
