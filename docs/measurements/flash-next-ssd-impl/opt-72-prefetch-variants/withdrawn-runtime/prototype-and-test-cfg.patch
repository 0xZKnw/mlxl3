+#[test]
+#[ignore = "physical Apple GPU; delayed independent graph checks prediction readback"]
+fn packed_prediction_readback_preserves_ids_without_waiting_for_later_work() -> Result<()> {
+    let (mut moe, inputs) = super::tests::resident_gate_fixture()?.remove(0);
+    let x = Array::concatenate(&[&inputs[0], &inputs[1]], 0)?;
+    let value = Array::from_f32(&[1.0], &[1])?.astype(Dtype::Float16)?;
+    let mut oracle = None;
+    let mut observed = Vec::new();
+    for variant in [PrefetchVariant::Legacy, PrefetchVariant::Packed] {
+        moe.prefetch_variant = variant;
+        let prediction = moe.predict(&x)?;
+        ensure!(
+            prediction.shape()
+                == if variant == PrefetchVariant::Packed {
+                    &[32][..]
+                } else {
+                    &[2, 16][..]
+                }
+        );
+        prediction.eval()?;
+        let delayed = hybrid_tests::delay(&value)?;
+        let ids = prediction.to_u32();
+        let ready = delayed.is_available_for_test();
+        let completion = delayed.eval();
+        let ids = ids?;
+        let ready = ready?;
+        completion?;
+        ensure!(ids.len() == 32 && ids.iter().all(|&id| id < 512));
+        match &oracle {
+            Some(expected) => ensure!(&ids == expected, "packing changed predicted IDs"),
+            None => oracle = Some(ids),
+        }
+        observed.push((variant, ready));
+    }
+    println!("PREDICTION_READBACK ids=32 exact=true later_ready={observed:?}");
+    ensure!(
+        observed
+            == [
+                (PrefetchVariant::Legacy, true),
+                (PrefetchVariant::Packed, false)
+            ],
+        "prediction readback did not reproduce the expected queue behavior"
+    );
+    Ok(())
+}
