+#[cfg(kani)]
+#[kani::proof]
+#[kani::unwind(12)]
+fn unused_prefetch_priority_excludes_pending_and_preserves_free_slots() {
+    let mut cache = ExpertCache::new(10).unwrap();
+    cache.prefer_unused_prefetch = true;
+    for i in 0..10 {
+        let occupied: bool = kani::any();
+        let pending: bool = kani::any();
+        cache.keys[i] = (occupied && !pending).then_some(i as u32);
+        cache.pending[i] = pending.then_some(511);
+        cache.prefetched[i] = cache.keys[i].is_some() && kani::any::<bool>();
+        cache.predicted[i] = kani::any();
+        cache.counts[i] = kani::any();
+        cache.ages[i] = kani::any();
+    }
+    let routed: u8 = kani::any();
+    let routed = [u32::from(routed)];
+    let victim = cache.victim(&routed);
+    if let Some(slot) = victim {
+        assert!(slot < 10 && cache.pending[slot].is_none());
+        assert!(cache.keys[slot].is_none_or(|id| !routed.contains(&id)));
+        for i in 0..10 {
+            if cache.pending[i].is_some() || cache.keys[i].is_some_and(|id| routed.contains(&id)) {
+                continue;
+            }
+            if cache.keys[i].is_none() {
+                assert!(cache.keys[slot].is_none());
+            }
+            if let (Some(id), Some(chosen)) = (cache.keys[i], cache.keys[slot]) {
+                if cache.predicted[id as usize] == cache.predicted[chosen as usize]
+                    && cache.prefetched[i]
+                {
+                    assert!(cache.prefetched[slot]);
+                }
+            }
+        }
+        kani::cover!(cache.keys[slot].is_some() && cache.prefetched[slot]);
+        kani::cover!(cache.keys[slot].is_none());
+    } else {
+        for i in 0..10 {
+            assert!(
+                cache.pending[i].is_some() || cache.keys[i].is_some_and(|id| routed.contains(&id))
+            );
+        }
+    }
+    kani::cover!(victim.is_none());
+}
+
+#[cfg(kani)]
+#[kani::proof]
+#[kani::unwind(514)]
+fn prediction_protection_preserves_the_explicit_cache_policy() {
+    let mut cache = ExpertCache::new(10).unwrap();
+    let original: bool = kani::any();
+    let enable: bool = kani::any();
+    cache.predictive_lru = original;
+    let ids: [u32; 2] = kani::any();
+    let result = cache.protect_predictions_with_lru(&ids, enable);
+    let valid = ids[0] < 512 && ids[1] < 512;
+    assert_eq!(result.is_ok(), valid);
+    assert_eq!(cache.predictive_lru, original || (valid && enable));
+    assert_eq!(cache.clock, 0);
+    assert_eq!(cache.prefetch_hits, 0);
+    if valid {
+        assert!(cache.predicted[ids[0] as usize] && cache.predicted[ids[1] as usize]);
+    }
+    kani::cover!(valid && !original && !enable && !cache.predictive_lru);
+    kani::cover!(valid && !original && enable && cache.predictive_lru);
+    kani::cover!(!valid && !original && enable && !cache.predictive_lru);
+}
