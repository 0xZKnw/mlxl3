+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub(crate) enum PrefetchVariant {
+    #[default]
+    Legacy,
+    Late,
+    Bounded,
+    Unused,
+    Lfu,
+    Weighted,
+    Packed,
+}
+
+impl PrefetchVariant {
+    pub(crate) fn parse(value: &str) -> Option<Self> {
+        Some(match value {
+            "legacy" => Self::Legacy,
+            "late" => Self::Late,
+            "bounded" => Self::Bounded,
+            "unused" => Self::Unused,
+            "lfu" => Self::Lfu,
+            "weighted" => Self::Weighted,
+            "packed" => Self::Packed,
+            _ => return None,
+        })
+    }
+}
+
+pub(crate) fn prediction_protection_len(ids: usize, budget: usize, room: bool) -> usize {
+    if room { ids.min(budget).min(4) } else { 0 }
+}
+
 pub(crate) fn prediction_rows(rows: usize) -> Option<usize> {
     (1..=8).contains(&rows).then_some(rows.min(2))
 }
