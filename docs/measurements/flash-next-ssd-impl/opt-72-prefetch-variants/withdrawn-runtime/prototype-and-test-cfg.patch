+#[cfg(kani)]
+#[kani::proof]
+fn prediction_protection_is_bounded_by_available_work() {
+    let ids: usize = kani::any();
+    let budget: usize = kani::any();
+    let room: bool = kani::any();
+    let keep = prediction_protection_len(ids, budget, room);
+    assert!(keep <= ids && keep <= budget && keep <= 4);
+    assert_eq!(keep == 0, !room || ids == 0 || budget == 0);
+    kani::cover!(room && ids == usize::MAX && budget == usize::MAX && keep == 4);
+    kani::cover!(!room && ids > 0 && budget > 0 && keep == 0);
+    kani::cover!(room && ids == 2 && budget == 1 && keep == 1);
+}
