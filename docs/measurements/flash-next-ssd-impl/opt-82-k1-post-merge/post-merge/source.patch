+#[test]
+#[ignore = "physical Apple GPU; native MLX Half H128 oracle, mask/rounding/strides; run alone"]
+fn hot_h128_matches_native_half_roundings_masks_and_layouts() -> Result<()> {
+    let mut cases = 0;
+    for routes in [1, 2, 10, 20, 30, 40, 50, 60, 70, 80] {
+        for repeat in [1, 2] {
+            for width in [640, 2560] {
+                for layout in [0, 1] {
+                    let x = input(routes, repeat, width, layout, 0)?;
+                    let reference = x
+                        .hadamard_transform(Some(1.0 / 128.0f32.sqrt()))?
+                        .to_bytes()?;
+                    ensure!(reference.iter().any(|&b| b != 0), "empty native oracle");
+                    for slots in masks(routes, 53, true) {
+                        exact(&x, &slots, 53, repeat as i32, &reference, true)?;
+                        cases += 1;
+                    }
+                }
+            }
+        }
+    }
+    ensure!(cases == 3144);
+    let mut edges = 0;
+    for repeat in [1, 2] {
+        for width in [640, 2560] {
+            for layout in [0, 1] {
+                for pattern in 0..6 {
+                    let x = input(20, repeat, width, layout, pattern)?;
+                    let reference = x
+                        .hadamard_transform(Some(1.0 / 128.0f32.sqrt()))?
+                        .to_bytes()?;
+                    for slots in masks(20, 53, false) {
+                        exact(
+                            &x,
+                            &slots,
+                            53,
+                            repeat as i32,
+                            &reference,
+                            pattern != 3 && pattern != 4,
+                        )?;
+                        edges += 1;
+                    }
+                }
+            }
+            let offset = input(20, repeat, width, 2, 0)?;
+            let reference = offset
+                .hadamard_transform(Some(1.0 / 128.0f32.sqrt()))?
+                .to_bytes()?;
+            for slots in masks(20, 53, false) {
+                exact(&offset, &slots, 53, repeat as i32, &reference, true)?;
+                edges += 1;
+            }
+            for capacity in [1, 512] {
+                let x = input(20, repeat, width, 0, 0)?;
+                let reference = x
+                    .hadamard_transform(Some(1.0 / 128.0f32.sqrt()))?
+                    .to_bytes()?;
+                for slots in masks(20, capacity, false) {
+                    exact(&x, &slots, capacity as i32, repeat as i32, &reference, true)?;
+                    edges += 1;
+                }
+            }
+        }
+    }
+    ensure!(edges == 240);
+    let mut fallbacks = 0;
+    let indices = Array::from_u32(&[u32::MAX; 20], &[20])?;
+    for dtype in [Dtype::Float32, Dtype::BFloat16] {
+        for blocks in [1, 5, 20] {
+            let x = input(20, 1, blocks * 128, 0, 0)?.astype(dtype)?;
+            let before = FAST_CALLS.with(std::cell::Cell::get);
+            let expected = x.hadamard_transform(Some(1.0 / 128.0f32.sqrt()))?;
+            let actual = hadamard(&x, &indices, 53, 1)?;
+            ensure!(FAST_CALLS.with(std::cell::Cell::get) == before);
+            ensure!(
+                actual.shape() == x.shape()
+                    && actual.dtype() == expected.dtype()
+                    && actual.to_bytes()? == expected.to_bytes()?
+            );
+            fallbacks += 1;
+        }
+    }
+    for repeat in [1, 2] {
+        for blocks in [1, 4] {
+            let x = input(20, repeat, blocks * 128, 0, 0)?;
+            let before = FAST_CALLS.with(std::cell::Cell::get);
+            ensure!(
+                hadamard(&x, &indices, 53, repeat as i32)?.to_bytes()?
+                    == x.hadamard_transform(Some(1.0 / 128.0f32.sqrt()))?
+                        .to_bytes()?
+            );
+            ensure!(FAST_CALLS.with(std::cell::Cell::get) == before);
+            fallbacks += 1;
+        }
+    }
+    ensure!(fallbacks == 10);
+    println!(
+        "FLASH_HOT_H128 cases={cases} edges={edges} fallbacks={fallbacks} hot=byte_exact cold=positive_zero readbacks=none layouts=contiguous,transpose,offset"
+    );
+    Ok(())
+}
