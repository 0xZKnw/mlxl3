+#[cfg(test)]
+thread_local! {
+    static FAST_CALLS: std::cell::Cell<usize> = const { std::cell::Cell::new(0) };
+}
+
+// Keep MLX's float registers and Half threadgroup roundings after each radix.
+const HEADER: &str = r#"
+template <short R>
+inline void mlxl3_hot_radix(thread float* x) {
+  constexpr short logR = __builtin_ctz(R);
+  short h = 1;
+  _Pragma("clang loop unroll(full)")
+  for (short s = 0; s < logR; s++) {
+    _Pragma("clang loop unroll(full)")
+    for (short i = 0; i < R / 2; i++) {
+      short k = i & (h - 1);
+      short j = ((i - k) << 1) + k;
+      float a = x[j];
+      float b = x[j + h];
+      x[j] = a + b;
+      x[j + h] = a - b;
+    }
+    h <<= 1;
+  }
+}
+"#;
+
+const KERNEL: &str = r#"
+uint row = threadgroup_position_in_grid.z;
+uint block = threadgroup_position_in_grid.y;
+uint base = (row * uint(values_shape[1]) + block) * 128u;
+short i = short(thread_position_in_threadgroup.x);
+// All eight lanes test one snapshot slot; no Cold lane reaches a barrier or values load.
+if (slots[row / MLXL3_REPEAT] >= MLXL3_CAPACITY) {
+  _Pragma("clang loop unroll(full)")
+  for (short j = 0; j < 4; j++) {
+    short index = j * 4 * 8 + i * 4;
+    _Pragma("clang loop unroll(full)")
+    for (short r = 0; r < 4; r++) out[base + index + r] = half(0);
+  }
+  return;
+}
+threadgroup half buf[128];
+_Pragma("clang loop unroll(full)")
+for (short j = 0; j < 4; j++) {
+  short index = j * 4 * 8 + i * 4;
+  _Pragma("clang loop unroll(full)")
+  for (short r = 0; r < 4; r++) buf[index + r] = values[base + index + r];
+}
