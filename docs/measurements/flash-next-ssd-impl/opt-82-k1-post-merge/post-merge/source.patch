+/// Flat launch size for the resident-Hot Half activation; no GPU/host reads.
+#[cfg(any(feature = "mlx", test, kani))]
+pub(crate) fn flash_hot_swiglu_grid(
+    shape: &[i32],
+    slot_shape: &[i32],
+    half: bool,
+    uint_slots: bool,
+    capacity: i32,
+) -> Option<i32> {
+    if !half || !uint_slots || !(1..=512).contains(&capacity) {
+        return None;
+    }
+    let [n, 2, 640] = shape else { return None };
+    if !(1..=80).contains(n) || slot_shape != [*n] {
+        return None;
+    }
+    Some(n * 640)
+}
+
+#[test]
+fn flash_hot_swiglu_grid_checks_actual_layout_and_boundaries() {
+    assert_eq!(
+        flash_hot_swiglu_grid(&[81, 2, 640], &[81], true, true, 53),
+        None
+    );
+    for n in 1..=80 {
+        for capacity in [1, 53, 512] {
+            assert_eq!(
+                flash_hot_swiglu_grid(&[n, 2, 640], &[n], true, true, capacity),
+                Some(n * 640)
+            );
+        }
+    }
+    for shape in [
+        &[][..],
+        &[20][..],
+        &[20, 640][..],
+        &[20, 2, 640, 1][..],
+        &[0, 2, 640][..],
+        &[81, 2, 640][..],
+        &[20, 1, 640][..],
+        &[20, 2, 639][..],
+        &[i32::MAX, 2, 640][..],
+        &[i32::MIN, 2, 640][..],
+    ] {
+        assert_eq!(flash_hot_swiglu_grid(shape, &[20], true, true, 53), None);
+    }
+    for slot_shape in [&[][..], &[19][..], &[20, 1][..], &[-1][..]] {
+        assert_eq!(
+            flash_hot_swiglu_grid(&[20, 2, 640], slot_shape, true, true, 53),
+            None
+        );
+    }
+    for capacity in [i32::MIN, -1, 0, 513, i32::MAX] {
+        assert_eq!(
+            flash_hot_swiglu_grid(&[20, 2, 640], &[20], true, true, capacity),
+            None
+        );
+    }
+    assert_eq!(
+        flash_hot_swiglu_grid(&[20, 2, 640], &[20], false, true, 53),
+        None
+    );
+    assert_eq!(
+        flash_hot_swiglu_grid(&[20, 2, 640], &[20], true, false, 53),
+        None
+    );
+}
+
+#[cfg(kani)]
+#[kani::proof]
+#[kani::unwind(5)]
+fn flash_hot_swiglu_grid_admits_only_bounded_half_layouts() {
+    let dimensions: [i32; 4] = kani::any();
+    let slots: [i32; 2] = kani::any();
+    let rank: usize = kani::any();
+    let slot_rank: usize = kani::any();
+    kani::assume(rank <= 4 && slot_rank <= 2);
+    let half: bool = kani::any();
+    let uint_slots: bool = kani::any();
+    let capacity: i32 = kani::any();
+    let actual = flash_hot_swiglu_grid(
+        &dimensions[..rank],
+        &slots[..slot_rank],
+        half,
+        uint_slots,
+        capacity,
+    );
+    let admissible = rank == 3
+        && slot_rank == 1
+        && half
+        && uint_slots
+        && capacity >= 1
+        && capacity <= 512
+        && dimensions[0] >= 1
+        && dimensions[0] <= 80
+        && dimensions[1] == 2
+        && dimensions[2] == 640
+        && slots[0] == dimensions[0];
+    assert_eq!(actual.is_some(), admissible);
+    if let Some(grid) = actual {
+        assert!(grid >= 640 && grid <= 51200);
+        assert_eq!(grid % 640, 0);
+        assert_eq!(grid / 640, dimensions[0]);
+    }
+    kani::cover!(actual == Some(640) && capacity == 1);
+    kani::cover!(actual == Some(51200) && capacity == 512);
+    kani::cover!(rank == 3 && slot_rank == 1 && !half && actual.is_none());
+    kani::cover!(rank == 3 && slot_rank == 1 && !uint_slots && actual.is_none());
+    kani::cover!(rank == 3 && slot_rank == 1 && capacity == 0 && actual.is_none());
+    kani::cover!(rank == 3 && slot_rank == 1 && dimensions[0] == 81 && actual.is_none());
+    kani::cover!(rank == 2 && actual.is_none());
+}
