+    moe.gpu_hot_wide = true;
+    let ids = moe.route(&input)?.0.to_u32()?;
+    ensure!(ids.len() == 10);
+    let routes = moe.cache.borrow_mut().reserve(&ids[..5])?;
+    let jobs = ids[..5]
+        .iter()
+        .zip(routes)
+        .map(|(&id, (slot, _))| (id, slot))
+        .collect::<Vec<_>>();
+    moe.fill_many(&jobs)?;
+    let x = Array::concatenate(&[&input, &input], 0)?;
+    for case in 0..4 {
+        if case >= 2 {
+            *moe.cache.borrow_mut() = ExpertCache::new(53)?;
+        }
+        if case == 3 {
+            let unrelated = (0..512)
+                .find(|id| !ids.contains(id))
+                .context("missing unrelated expert")?;
+            let slot = moe.cache.borrow_mut().reserve(&[unrelated])?[0].0;
+            moe.fill_many(&[(unrelated, slot)])?;
+        }
+        let snapshot = moe.cache.borrow().resident_slot_map()?;
+        let readbacks = moe.route_readbacks;
+        crate::flash_profile::start(false)?;
+        let result = (|| -> Result<Vec<crate::flash_profile::Event>> {
+            ensure!(moe.forward_draft_rows(&x)?.to_bytes()? == captured.repeat(2));
+            moe.drain()?;
+            crate::flash_profile::finish()
+        })();
+        let events = match result {
+            Ok(events) => events,
+            Err(error) => {
+                let _ = crate::flash_profile::finish();
+                return Err(error);
+            }
+        };
+        ensure!(
+            moe.route_readbacks == readbacks + 1,
+            "profile changed route readbacks"
+        );
+        let events = serde_json::to_value(events)?;
+        let rows = events
+            .as_array()
+            .context("invalid profile")?
+            .iter()
+            .filter(|e| e["name"] == "moe_forward_rows")
+            .collect::<Vec<_>>();
+        ensure!(rows.len() == 1);
+        let data = &rows[0]["data"];
+        ensure!(data["rows"] == 2 && data["ids"] == serde_json::json!(ids.repeat(2)));
+        ensure!(data["early_hot"] == (case != 2));
+        if case != 2 {
+            // Independent fixture lookup; do not call the instrumentation helper as oracle.
+            let expected = ids
+                .repeat(2)
+                .iter()
+                .map(|&id| snapshot[id as usize])
+                .collect::<Vec<_>>();
+            ensure!(data["resident_gpu_slots"] == serde_json::json!(expected));
+            let expected_hot = match case {
+                0 => 10,
+                1 => 20,
+                3 => 0,
+                _ => unreachable!(),
+            };
+            ensure!(data["resident_gpu_rows"] == expected_hot);
+            if case == 0 {
+                ensure!(snapshot[ids[5] as usize] == u32::MAX);
+                ensure!(moe.cache.borrow().resident_slot_map()?[ids[5] as usize] != u32::MAX);
+            }
+        } else {
+            ensure!(data["resident_gpu_slots"].is_null() && data["resident_gpu_rows"] == 0);
+        }
+    }
+    println!(
+        "FLASH_HOT_PROFILE cases=4 rows=2 snapshot_before_reservation=true ordered_slots=exact readbacks=unchanged parity=byte_exact"
+    );
+    Ok(())
+}
