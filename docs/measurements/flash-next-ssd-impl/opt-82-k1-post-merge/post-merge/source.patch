+// N128/max_radix16: exactly one radix16, then two radix8 butterflies per lane.
+short k = i & (h - 1);
+short j = ((i - k) << 4) + k;
+_Pragma("clang loop unroll(full)")
+for (short r = 0; r < 16; r++) x[r] = buf[j + h * r];
+mlxl3_hot_radix<16>(x);
+_Pragma("clang loop unroll(full)")
+for (short r = 0; r < 16; r++) buf[j + h * r] = half(x[r]);
+h <<= 4;
+threadgroup_barrier(mem_flags::mem_threadgroup);
+_Pragma("clang loop unroll(full)")
+for (int t = 0; t < 2; t++) {
+  short index = i + t * 8;
+  short k = index & (h - 1);
+  short j = ((index - k) << 3) + k;
+  _Pragma("clang loop unroll(full)")
