+//! Resident-Hot activation; Cold lanes never inspect gate/up values.
+use super::*;
+
+// MLX 0.32.2 unary_ops.h::Sigmoid and binary_ops.h::Multiply (Apple, MIT).
+// Keep the type of every node: half sigmoid, half gate*sigmoid, half silu*up.
+const HEADER: &str = r#"
+struct Mlxl3HotSigmoid {
+    template <typename T> T operator()(T x) thread {
+        auto y = 1 / (1 + metal::exp(metal::abs(x)));
+        return (x < 0) ? y : 1 - y;
+    }
+};
+struct Mlxl3HotMultiply {
+    template <typename T> T operator()(T x, T y) thread { return x * y; }
+};
+"#;
+
+const SOURCE: &str = r#"
+uint i = thread_position_in_grid.x;
+if (i >= uint(gu_shape[0]) * 640u) return;
+uint row = i / 640u;
+if (slots[row] >= CAPACITY) { activated[i] = half(0); return; }
+uint col = i % 640u;
+half gate = gu[row * 1280u + col];
+half up = gu[row * 1280u + 640u + col];
+half sigmoid = Mlxl3HotSigmoid()(gate);
+half silu = Mlxl3HotMultiply()(gate, sigmoid);
+activated[i] = Mlxl3HotMultiply()(silu, up);
+"#;
+
+pub(super) fn apply(gu: &Array, slots: &linear::ExpertSlots) -> Result<Array> {
+    let n = *slots
+        .indices()
+        .shape()
+        .first()
+        .context("missing expert routes")?;
+    if !slots.is_masked() || gu.dtype() != Dtype::Float16 {
+        return gu
+            .slice(1, 0, 1)?
+            .reshape(&[n, I])?
+            .swiglu(&gu.slice(1, 1, 2)?.reshape(&[n, I])?);
+    }
+    let grid = crate::flash_support::flash_hot_swiglu_grid(
+        gu.shape(),
+        slots.indices().shape(),
+        gu.dtype() == Dtype::Float16,
+        slots.indices().dtype() == Dtype::UInt32,
+        slots.capacity(),
+    )
+    .context("invalid resident Hot activation layout")?;
+    crate::array::metal_kernel(
+        "mlxl3_hot_swiglu",
+        &["gu", "slots"],
+        &["activated"],
+        &format!(
+            "{HEADER}\nconstant uint CAPACITY = {}u;\n",
+            slots.capacity()
+        ),
+        SOURCE,
+        &[gu, slots.indices()],
+        &[vec![n, I]],
+        &[Dtype::Float16],
+        [grid, 1, 1],
+        [128, 1, 1],
+    )?
+    .pop()
+    .context("missing resident Hot activation")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    pub(super) fn inputs(n: i32, cold: &[bool], strided: bool, nonfinite: bool) -> Result<Array> {
+        let value = |r: i32, p: i32, c: i32| {
+            if cold[r as usize] {
+                0x7e35 // Poison must not leak from a Cold row.
+            } else if nonfinite {
+                [
+                    0x0000, 0x8000, 0x0001, 0x8001, 0x7bff, 0xfbff, 0x7c00, 0xfc00, 0x7e35, 0xfe21,
+                    0x3c01, 0xbc01,
+                ][(c as usize + 3 * p as usize + r as usize) % 12]
+            } else {
+                let x = ((r * 179 + p * 89 + c * 37) % 8191 - 4095) as f32;
+                half::f16::from_f32(x / if p == 0 { 463.0 } else { 1031.0 }).to_bits()
+            }
+        };
+        if strided {
+            let values = (0..I)
+                .flat_map(|c| (0..2).flat_map(move |p| (0..n).map(move |r| value(r, p, c))))
+                .collect::<Vec<_>>();
+            Array::from_f16_bits(&values, &[I, 2, n])?.transpose(&[2, 1, 0])
+        } else {
+            let values = (0..n)
+                .flat_map(|r| (0..2).flat_map(move |p| (0..I).map(move |c| value(r, p, c))))
+                .collect::<Vec<_>>();
+            Array::from_f16_bits(&values, &[n, 2, I])
+        }
+    }
+
+    fn resident(n: i32, pattern: usize, capacity: i32) -> Result<(linear::ExpertSlots, Vec<bool>)> {
+        let mut map = [u32::MAX; 512];
+        let mut cold = Vec::new();
+        for (r, slot) in map.iter_mut().enumerate().take(n as usize) {
+            let hot = match pattern {
+                0 => false,
+                1 => true,
+                2 => r % 2 == 0,
+                3 => r == 0,
+                4 => r + 1 == n as usize,
+                5 => r % 3 != 1,
+                _ => unreachable!(),
+            };
+            if hot {
+                *slot = if r % 2 == 0 { 0 } else { capacity as u32 - 1 };
+            }
+            cold.push(!hot);
+        }
+        let ids = Array::from_u32(&(0..n as u32).collect::<Vec<_>>(), &[n])?;
+        Ok((linear::ExpertSlots::residents(&ids, &map, capacity)?, cold))
+    }
+
+    pub(super) fn oracle(gu: &Array, n: i32) -> Result<Array> {
+        // Independent real MLX graph; do not call the candidate's MSL operations.
+        gu.slice(1, 0, 1)?
+            .reshape(&[n, I])?
+            .swiglu(&gu.slice(1, 1, 2)?.reshape(&[n, I])?)
+    }
+
+    fn check(gu: &Array, slots: &linear::ExpertSlots, cold: &[bool], finite: bool) -> Result<()> {
+        let n = cold.len() as i32;
+        let mut expected = oracle(gu, n)?.to_bytes()?;
+        let masked_half = slots.is_masked() && gu.dtype() == Dtype::Float16;
+        if masked_half {
+            for (row, &cold) in cold.iter().enumerate() {
+                if cold {
+                    expected[row * I as usize * 2..(row + 1) * I as usize * 2].fill(0);
+                }
+            }
+        }
+        let before = Array::host_readbacks_for_test();
+        let actual = apply(gu, slots)?;
+        ensure!(
+            Array::host_readbacks_for_test() == before,
+            "activation added a readback"
+        );
+        ensure!(actual.shape() == [n, I] && actual.dtype() == gu.dtype());
+        let bytes = actual.to_bytes()?;
+        ensure!(
+            !bytes.is_empty() && bytes == expected,
+            "Hot activation differs from MLX nodes"
+        );
+        if finite {
+            let values = actual.to_f32()?;
+            ensure!(
+                values.len() == n as usize * I as usize && values.iter().all(|v| v.is_finite())
+            );
+        }
+        Ok(())
+    }
+
+    #[test]
+    #[ignore = "physical Apple GPU; exact masked Half activation, no model or timing"]
+    fn masked_hot_swiglu_matches_real_mlx_nodes_and_cold_positive_zero() -> Result<()> {
+        let mut cases = 0;
+        for n in 1..=80 {
+            let capacity = [1, 53, 512][n as usize % 3];
+            for pattern in 0..6 {
+                let (slots, cold) = resident(n, pattern, capacity)?;
+                for strided in [false, true] {
+                    check(&inputs(n, &cold, strided, false)?, &slots, &cold, true)?;
+                    cases += 1;
+                }
+            }
+        }
+        ensure!(cases == 960);
+        let (slots, cold) = resident(20, 1, 53)?;
+        for strided in [false, true] {
+            check(&inputs(20, &cold, strided, true)?, &slots, &cold, false)?;
+        }
+        let mut map = [u32::MAX; 512];
+        map[0] = 0;
+        map[511] = 52;
+        let selected = Array::from_u32(&[0, 511, 512, u32::MAX], &[4])?;
+        let boundary = linear::ExpertSlots::residents(&selected, &map, 53)?;
+        let cold = [false, false, true, true];
+        check(&inputs(4, &cold, false, false)?, &boundary, &cold, true)?;
+        println!(
+            "FLASH_HOT_ACTIVATION cases=960 nonfinite_cases=2 id_boundary_cases=1 routes=1..80 masks=6 strides=2 hot=byte_exact cold=positive_zero readbacks=unchanged"
+        );
+        Ok(())
+    }
+
+    #[test]
+    #[ignore = "physical Apple GPU; historical unmasked/dtype fallback and invalid layouts"]
+    fn hot_swiglu_fallbacks_and_invalid_layouts_keep_contract() -> Result<()> {
+        let mut fallbacks = 0;
+        for n in [1, 10, 20, 80] {
+            let cold = vec![false; n as usize];
+            let slots = linear::ExpertSlots::new(&vec![0; n as usize], 53)?;
+            for dtype in [Dtype::Float16, Dtype::Float32, Dtype::BFloat16] {
+                for strided in [false, true] {
+                    let gu = inputs(n, &cold, strided, false)?.astype(dtype)?;
+                    check(&gu, &slots, &cold, true)?;
+                    fallbacks += 1;
+                }
+            }
+        }
+        let (slots, cold) = resident(20, 2, 53)?;
+        for dtype in [Dtype::Float32, Dtype::BFloat16] {
+            for strided in [false, true] {
+                let gu = inputs(20, &[false; 20], strided, false)?.astype(dtype)?;
+                check(&gu, &slots, &cold, true)?;
+                fallbacks += 1;
+            }
+        }
+        ensure!(fallbacks == 28);
+        let mut invalid = 0;
+        for shape in [
+            vec![20, I],
+            vec![20, 1, I],
+            vec![20, 2, I - 1],
+            vec![19, 2, I],
+            vec![20, 2, I + 1],
+        ] {
+            ensure!(apply(&Array::zeros_dtype(&shape, Dtype::Float16)?, &slots).is_err());
+            invalid += 1;
+        }
+        let map = [u32::MAX; 512];
+        for capacity in [0, 513] {
+            ensure!(
+                linear::ExpertSlots::residents(&Array::from_u32(&[0], &[1])?, &map, capacity)
+                    .is_err()
+            );
+            invalid += 1;
+        }
+        ensure!(
+            linear::ExpertSlots::residents(&Array::zeros_dtype(&[1], Dtype::Float32)?, &map, 53)
+                .is_err()
+        );
+        invalid += 1;
+        ensure!(
+            linear::ExpertSlots::residents(&Array::from_u32(&[0; 81], &[81])?, &map, 53).is_err()
+        );
+        invalid += 1;
+        let mut bad_map = map;
+        bad_map[0] = 53;
+        ensure!(
+            linear::ExpertSlots::residents(&Array::from_u32(&[0], &[1])?, &bad_map, 53).is_err()
+        );
+        invalid += 1;
+        ensure!(invalid == 10);
+        println!(
+            "FLASH_HOT_ACTIVATION_FALLBACK cases=28 invalid=10 parity=byte_exact historical_unmasked_and_nonhalf=true"
+        );
+        Ok(())
+    }
+
+    #[cfg(kani)]
+    #[kani::proof]
+    fn actual_masked_activation_preserves_mlx_nodes() {
+        masked_hot_swiglu_matches_real_mlx_nodes_and_cold_positive_zero().unwrap();
+    }
+}
