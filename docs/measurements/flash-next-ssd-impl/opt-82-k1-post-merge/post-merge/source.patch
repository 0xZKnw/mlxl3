+//! Isolated component wall time; no model or release throughput claim.
+use super::*;
+use serde_json::{Value, json};
+use std::{
+    fs::OpenOptions,
+    io::{Seek, SeekFrom, Write},
+    path::Path,
+    time::Instant,
+};
+
+const NAMES: [&str; 8] = [
+    "MAIN-p05",
+    "MAIN-p50",
+    "MAIN-p95",
+    "HOLD-p05",
+    "HOLD-p50",
+    "HOLD-p95",
+    "synthetic-all-hot",
+    "synthetic-all-cold-nonempty-map",
+];
+const HOT: [usize; 8] = [7, 14, 19, 7, 14, 19, 20, 0];
+
+fn fixtures(value: &Value) -> Result<Vec<[u32; 20]>> {
+    ensure!(
+        value["status"] == "fixed_before_any_kernel_timing",
+        "unfrozen component fixtures"
+    );
+    let entries = value["fixtures"]
+        .as_array()
+        .context("missing component fixtures")?;
+    ensure!(entries.len() == 8, "expected eight component fixtures");
+    entries
+        .iter()
+        .enumerate()
+        .map(|(i, f)| {
+            ensure!(
+                f["name"] == NAMES[i]
+                    && f["routes"].as_u64() == Some(20)
+                    && f["capacity"].as_u64() == Some(53),
+                "invalid component fixture identity/layout"
+            );
+            let values = f["slots"].as_array().context("missing component slots")?;
+            ensure!(values.len() == 20, "invalid component slot count");
+            let mut slots = [0; 20];
+            for (slot, value) in slots.iter_mut().zip(values) {
+                *slot = u32::try_from(value.as_u64().context("invalid unsigned component slot")?)?;
+                ensure!(
+                    *slot == u32::MAX || *slot < 53,
+                    "component slot outside bank"
+                );
+            }
+            let hot = slots.iter().filter(|&&s| s != u32::MAX).count();
+            ensure!(
+                hot == HOT[i] && f["hot"].as_u64() == Some(hot as u64),
+                "component Hot count mismatch"
+            );
+            Ok(slots)
+        })
+        .collect()
+}
+
+fn report_file(path: &Path) -> Result<std::fs::File> {
+    Ok(OpenOptions::new().write(true).create_new(true).open(path)?)
+}
+
+fn save(file: &mut std::fs::File, value: &Value) -> Result<()> {
+    file.seek(SeekFrom::Start(0))?;
+    file.set_len(0)?;
+    serde_json::to_writer(&mut *file, value)?;
+    file.flush()?;
+    Ok(())
+}
+
+fn chain(
+    gu: &Array,
+    slots: &linear::ExpertSlots,
+    base_gate: &Array,
+    base_up: &Array,
+    scale: &Array,
+    candidate: bool,
+) -> Result<Array> {
+    let mut current = gu.try_clone()?;
+    let mut result = None;
+    for step in 0..32 {
+        let activated = if candidate {
+            apply(&current, slots)?
+        } else {
+            super::tests::oracle(&current, 20)?
+        };
+        if step != 31 {
+            let gate = base_gate.add(&activated.mul(scale)?)?;
+            current = Array::concatenate(&[&gate, base_up], 1)?.reshape(&[20, 2, I])?;
+        }
+        result = Some(activated);
+    }
+    result.context("empty activation chain")
+}
+
+fn exact(value: &Array, expected: Option<&[u8]>, slots: &[u32; 20]) -> Result<Vec<u8>> {
+    ensure!(value.shape() == [20, I] && value.dtype() == Dtype::Float16);
+    let numbers = value.to_f32()?;
+    ensure!(
+        numbers.len() == 20 * I as usize && numbers.iter().all(|x| x.is_finite()),
+        "nonfinite component chain"
+    );
+    let bytes = value.to_bytes()?;
+    ensure!(bytes.len() == 20 * I as usize * 2 && !bytes.is_empty());
+    if let Some(expected) = expected {
+        ensure!(bytes == expected, "component full-chain parity failed");
+    }
+    for (row, &slot) in slots.iter().enumerate() {
+        if slot == u32::MAX {
+            ensure!(
+                bytes[row * I as usize * 2..(row + 1) * I as usize * 2]
+                    .iter()
+                    .all(|&x| x == 0),
+                "Cold chain is not positive zero"
+            );
+        }
+    }
+    Ok(bytes)
+}
+
+#[test]
+#[ignore = "physical Apple GPU; 32-call activation component wall time, not tok/s"]
+fn masked_hot_activation_component_aa_abba() -> Result<()> {
+    let path = std::path::PathBuf::from(std::env::var("MLXL3_HOT_TRANSFORM_FIXTURES")?);
+    let output = std::path::PathBuf::from(std::env::var("MLXL3_HOT_TRANSFORM_OUTPUT")?);
+    run(&path, &output)
+}
+
+fn run(path: &Path, output: &Path) -> Result<()> {
+    let mut file = report_file(output)?; // Refuse overwrite before any GPU work.
+    let mut report = json!({"status":"incomplete","parity":false,"stage":"SwiGLU","samples":[],"fixture_file":path,"limits":"Synthetic GU plus real masks, no captured decoder activations; common recurrence/graph construction/dispatch included; not exclusive GPU time or release tok/s"});
+    save(&mut file, &report)?;
+    let outcome = (|| -> Result<()> {
+        ensure!(
+            std::fs::metadata(path)?.len() <= 64 << 10,
+            "component fixtures exceed 64KiB"
+        );
+        let raw = std::fs::read(path)?;
+        let data: Value = serde_json::from_slice(&raw)?;
+        let entries = fixtures(&data)?; // Validate all eight before GPU initialization.
+        report["fixtures"] = data;
+        report["fixture_file_fnv1a64"] = json!(format!(
+            "{:016x}",
+            raw.iter()
+                .fold(0xcbf29ce484222325u64, |h, &b| (h ^ u64::from(b))
+                    .wrapping_mul(0x100000001b3))
+        ));
+        for (fixture, mapping) in entries.iter().enumerate() {
+            let mut map = [u32::MAX; 512];
+            map[..20].copy_from_slice(mapping);
+            map[511] = 0; // Keep the all-Cold fixture's original map nonempty.
+            let selected = Array::from_u32(&(0..20).collect::<Vec<_>>(), &[20])?;
+            let slots = linear::ExpertSlots::residents(&selected, &map, 53)?;
+            let mut bytes = super::tests::inputs(20, &[false; 20], false, false)?.to_bytes()?;
+            for (row, &slot) in mapping.iter().enumerate() {
+                if slot == u32::MAX {
+                    bytes[row * 2 * I as usize * 2..(row + 1) * 2 * I as usize * 2].fill(0);
+                }
+            }
+            let gu = Array::from_bytes(&bytes, &[20, 2, I], Dtype::Float16)?;
+            let gate = gu.slice(1, 0, 1)?.reshape(&[20, I])?;
+            let up = gu.slice(1, 1, 2)?.reshape(&[20, I])?;
+            let scale = Array::from_f16_bits(&[0x3000], &[1])?; // Exactly 1/8 Half.
+            gu.eval()?;
+            gate.eval()?;
+            up.eval()?;
+            scale.eval()?;
+            slots.indices().eval()?;
+            let expected = exact(
+                &chain(&gu, &slots, &gate, &up, &scale, false)?,
+                None,
+                mapping,
+            )?;
+            exact(
+                &chain(&gu, &slots, &gate, &up, &scale, true)?,
+                Some(&expected),
+                mapping,
+            )?;
+            for candidate in [false, true] {
+                for _ in 0..8 {
+                    if candidate {
+                        apply(&gu, &slots)?
+                    } else {
+                        super::tests::oracle(&gu, 20)?
+                    }
+                    .eval()?;
+                }
+            }
+            // One A/A calibration block, then five ABBA blocks, each four samples.
+            for block in 0..6 {
+                for (position, candidate) in if block == 0 {
+                    [false; 4]
+                } else {
+                    [false, true, true, false]
+                }
+                .into_iter()
+                .enumerate()
+                {
+                    let start = Instant::now();
+                    let value = chain(&gu, &slots, &gate, &up, &scale, candidate)?;
+                    value.eval()?;
+                    let seconds = start.elapsed().as_secs_f64();
+                    ensure!(
+                        seconds.is_finite() && seconds > 0.0,
+                        "invalid component duration"
+                    );
+                    exact(&value, Some(&expected), mapping)?; // All host reads outside the clock.
+                    report["samples"].as_array_mut().context("invalid component report")?.push(json!({"fixture":NAMES[fixture],"phase":if block==0 {"AA"} else {"ABBA"},"block":block,"position":position,"candidate":candidate,"calls":32,"common_recurrences":31,"seconds":seconds}));
+                }
+            }
+        }
+        ensure!(
+            report["samples"]
+                .as_array()
+                .context("missing samples")?
+                .len()
+                == 192
+        );
+        Ok(())
+    })();
+    if let Err(error) = outcome {
+        report["status"] = json!("failed_or_interrupted");
+        report["error"] = json!(format!("{error:#}"));
+        save(&mut file, &report)?;
+        return Err(error);
+    }
+    report["status"] = json!("complete_component_wall_not_throughput");
+    report["parity"] = json!(true);
+    report["warmups_per_arm_per_fixture"] = json!(8);
+    report["warmup_operations_per_iteration"] = json!(1);
+    save(&mut file, &report)?;
+    println!(
+        "FLASH_HOT_ACTIVATION_BENCH fixtures=8 samples=192 calls=32 calibration=AA blocks=5ABBA full_chain=byte_exact finite=true scope=component_wall"
+    );
+    Ok(())
+}
+
+#[test]
+fn activation_bench_rejects_malformed_fixtures_and_existing_report() -> Result<()> {
+    let mut value = json!({"status":"fixed_before_any_kernel_timing","fixtures":NAMES.iter().enumerate().map(|(i,name)| json!({"name":name,"routes":20,"capacity":53,"hot":HOT[i],"slots":(0..20).map(|r| if r < HOT[i] {0} else {u32::MAX}).collect::<Vec<_>>()})).collect::<Vec<_>>()});
+    ensure!(fixtures(&value)?.len() == 8);
+    for (key, bad) in [
+        ("routes", json!(21)),
+        ("routes", json!(true)),
+        ("capacity", json!(0)),
+        ("hot", json!(0)),
+        ("name", json!("wrong")),
+        ("slots", json!([])),
+    ] {
+        let saved = value["fixtures"][0][key].clone();
+        value["fixtures"][0][key] = bad;
+        ensure!(fixtures(&value).is_err());
+        value["fixtures"][0][key] = saved;
+    }
+    for bad in [json!(-1), json!(true), json!(53), json!(u64::MAX)] {
+        let saved = value["fixtures"][0]["slots"][0].clone();
+        value["fixtures"][0]["slots"][0] = bad;
+        ensure!(fixtures(&value).is_err());
+        value["fixtures"][0]["slots"][0] = saved;
+    }
+    let directory = tempfile::tempdir()?;
+    let path = directory.path().join("report.json");
+    drop(report_file(&path)?);
+    std::fs::write(&path, b"keep me")?;
+    ensure!(report_file(&path).is_err() && std::fs::read(&path)? == b"keep me");
+    ensure!(fixtures(&json!({"status":"incomplete","fixtures":[]})).is_err());
+    let bad = directory.path().join("bad-fixtures.json");
+    let failed = directory.path().join("failed-report.json");
+    std::fs::write(&bad, b"{\"fixtures\":[]}")?;
+    ensure!(run(&bad, &failed).is_err());
+    let failure: Value = serde_json::from_slice(&std::fs::read(&failed)?)?;
+    ensure!(failure["status"] == "failed_or_interrupted" && failure["parity"] == false);
+    ensure!(failure["samples"].as_array().is_some_and(Vec::is_empty));
+    ensure!(run(&bad, &path).is_err() && std::fs::read(&path)? == b"keep me");
+    let oversized = directory.path().join("oversized.json");
+    std::fs::write(&oversized, vec![b' '; (64 << 10) + 1])?;
+    let oversized_report = directory.path().join("oversized-report.json");
+    ensure!(run(&oversized, &oversized_report).is_err());
+    let failure: Value = serde_json::from_slice(&std::fs::read(&oversized_report)?)?;
+    ensure!(failure["status"] == "failed_or_interrupted" && failure["parity"] == false);
+    Ok(())
+}
+
+#[cfg(kani)]
+#[kani::proof]
+fn actual_activation_bench_fixture_failures() {
+    activation_bench_rejects_malformed_fixtures_and_existing_report().unwrap();
+}
