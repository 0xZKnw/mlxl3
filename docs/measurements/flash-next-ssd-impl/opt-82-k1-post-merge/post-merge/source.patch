+use super::*;
+use serde_json::{Value, json};
+use std::{
+    collections::BTreeSet,
+    fs,
+    path::{Component, Path},
+    time::Instant,
+};
+
+fn input(
+    routes: usize,
+    repeat: usize,
+    width: usize,
+    layout: usize,
+    pattern: usize,
+) -> Result<Array> {
+    let rows = routes * repeat;
+    let value = |row: usize, col: usize| -> u16 {
+        match pattern {
+            0 => half::f16::from_f32(((row * 37 + col * 13) % 997) as f32 / 1024. - 0.5).to_bits(),
+            1 => {
+                if (row + col).is_multiple_of(2) {
+                    0
+                } else {
+                    0x8000
+                }
+            }
+            2 => [1, 0x8001, 0x03ff, 0x83ff, 0x0400, 0x8400][(row + col) % 6],
+            3 => [0x7bff, 0xfbff, 0x6c00, 0xec00, 0x4000, 0xc000][(row + col) % 6],
+            4 => [0x7e17, 0x7c00, 0xfc00, 0xfe31, 0, 0x8000][(row + col) % 6],
+            5 => [0x3bff, 0x3c00, 0x3c01, 0xbbff, 0xbc00, 0xbc01][(row + col) % 6],
+            _ => unreachable!(),
+        }
+    };
+    let blocks = width / 128;
+    if layout == 1 {
+        let bits = (0..blocks)
+            .flat_map(|b| {
+                (0..rows).flat_map(move |row| (0..128).map(move |j| value(row, b * 128 + j)))
+            })
+            .collect::<Vec<_>>();
+        Array::from_f16_bits(&bits, &[blocks as i32, rows as i32, 128])?.transpose(&[1, 0, 2])
+    } else {
+        let padded = rows + usize::from(layout == 2);
+        let bits = (0..padded)
+            .flat_map(|row| (0..width).map(move |j| value(row, j)))
+            .collect::<Vec<_>>();
+        let x = Array::from_f16_bits(&bits, &[padded as i32, blocks as i32, 128])?;
+        if layout == 2 {
+            x.slice(0, 1, rows as i32 + 1)
+        } else {
+            Ok(x)
+        }
+    }
+}
+
+fn masks(routes: usize, capacity: u32, singles: bool) -> Vec<Vec<u32>> {
+    let hot = (0..routes).map(|i| i as u32 % capacity).collect::<Vec<_>>();
+    let mut result = vec![
+        hot.clone(),
+        vec![u32::MAX; routes],
+        hot.iter()
+            .enumerate()
+            .map(|(i, &slot)| if i % 2 == 0 { slot } else { capacity })
+            .collect(),
+    ];
+    if singles {
+        for i in 0..routes {
+            let mut slots = vec![u32::MAX; routes];
+            slots[i] = hot[i];
+            result.push(slots);
+        }
+    } else {
+        let mut slots = vec![u32::MAX; routes];
+        slots[routes - 1] = capacity - 1;
+        result.push(slots);
+    }
+    result
+}
+
+fn exact(
+    values: &Array,
+    slots: &[u32],
+    capacity: i32,
+    repeat: i32,
+    reference: &[u8],
+    finite: bool,
+) -> Result<()> {
+    let shape = values.shape();
+    let indices = Array::from_u32(slots, &[slots.len() as i32])?;
+    let reads = Array::host_readbacks_for_test();
+    let calls = FAST_CALLS.with(std::cell::Cell::get);
+    let actual = hadamard(values, &indices, capacity, repeat)?;
+    ensure!(
+        FAST_CALLS.with(std::cell::Cell::get) == calls + 1,
+        "masked H128 fast path was not selected"
+    );
+    ensure!(
+        Array::host_readbacks_for_test() == reads,
+        "masked H128 introduced a readback"
+    );
+    ensure!(actual.shape() == shape && actual.dtype() == Dtype::Float16);
+    let bytes = actual.to_bytes()?;
+    let width = shape[1] as usize * 128;
+    ensure!(bytes.len() == reference.len() && bytes.len() == shape[0] as usize * width * 2);
+    if finite {
+        ensure!(
+            reference
+                .as_chunks::<2>()
+                .0
+                .iter()
+                .all(|bits| half::f16::from_bits(u16::from_le_bytes(*bits)).is_finite()),
+            "finite-matrix native oracle is nonfinite"
+        );
+    }
+    for row in 0..shape[0] as usize {
+        let range = row * width * 2..(row + 1) * width * 2;
+        if slots[row / repeat as usize] < capacity as u32 {
+            if finite {
+                ensure!(
+                    bytes[range.clone()]
+                        .as_chunks::<2>()
+                        .0
+                        .iter()
+                        .all(|bits| half::f16::from_bits(u16::from_le_bytes(*bits)).is_finite()),
+                    "finite-matrix Hot H128 is nonfinite"
+                );
+            }
+            ensure!(
+                bytes[range.clone()] == reference[range],
+                "Hot H128 bits changed at row{row}"
+            );
+        } else {
+            ensure!(
+                bytes[range].iter().all(|&byte| byte == 0),
+                "Cold H128 output was not initialized +0"
+            );
+        }
+    }
+    Ok(())
+}
