+#[test]
+#[ignore = "physical Apple GPU; existing resident snapshot profile, one MoE, no timing"]
+fn hot_profile_reports_original_snapshot_before_reservation_and_fill() -> Result<()> {
+    let (checkpoint, input, captured) = super::tests::admission_fixture()?;
+    let mut moe = SsdMoe::load(&checkpoint, "model.language_model.layers.0.mlp", 53, true)?;
