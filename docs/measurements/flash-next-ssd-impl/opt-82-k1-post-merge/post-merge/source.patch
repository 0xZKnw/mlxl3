+  short index = j * 4 * 8 + i * 4;
+  _Pragma("clang loop unroll(full)")
+  for (short r = 0; r < 4; r++) out[base + index + r] = half(buf[index + r] * scale);
+}
+"#;
+
+pub(super) fn hadamard(values: &Array, slots: &Array, capacity: i32, repeat: i32) -> Result<Array> {
+    let scale = 1.0 / 128.0f32.sqrt();
+    let shape = values.shape();
+    let Some(grid) = crate::flash_support::flash_hot_h128_grid(
+        shape,
+        slots.shape(),
+        values.dtype() == Dtype::Float16,
+        slots.dtype() == Dtype::UInt32,
+        capacity,
+        repeat,
+    ) else {
+        // Other formats and geometries keep the exact existing MLX operation.
+        return values.hadamard_transform(Some(scale));
+    };
+    #[cfg(test)]
+    FAST_CALLS.with(|count| count.set(count.get() + 1));
+    let header = format!(
+        "{HEADER}\n#define MLXL3_CAPACITY {capacity}u\n#define MLXL3_REPEAT {repeat}u\n#define MLXL3_SCALE_BITS 0x{:08x}u\n",
+        scale.to_bits()
+    );
+    Ok(array::metal_kernel(
+        "mlxl3_hot_h128_half",
+        &["values", "slots"],
+        &["out"],
+        &header,
+        KERNEL,
+        &[values, slots],
+        &[shape.to_vec()],
+        &[Dtype::Float16],
+        grid,
+        [8, 1, 1],
+    )?
+    .remove(0))
+}
