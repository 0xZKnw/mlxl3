+fn qa_inputs(root: &Path, oracle: &Value, layer: usize) -> Result<[Vec<f32>; 2]> {
+    let mut rows = Vec::new();
+    for step in [0, 1] {
+        let entry = &oracle["steps"][step]["components"][layer]["mlp"]["input"];
+        ensure!(entry["count"] == 2560);
+        let file = entry["file"].as_str().context("missing QA input")?;
+        ensure!(
+            !file.is_empty()
+                && Path::new(file)
+                    .components()
+                    .all(|c| matches!(c, Component::Normal(_))),
+            "invalid QA path"
+        );
+        let bytes = fs::read(root.join(file))?;
+        ensure!(bytes.len() == 2560 * 4);
+        let row = bytes
+            .as_chunks::<4>()
+            .0
+            .iter()
+            .map(|b| f32::from_le_bytes(*b))
+            .collect::<Vec<_>>();
+        ensure!(row.len() == 2560 && row.iter().all(|v| v.is_finite()));
+        rows.push(row);
+    }
+    rows.try_into()
+        .map_err(|_| anyhow::anyhow!("missing QA rows"))
+}
+
+fn chained(
+    input: &Array,
+    slots: &Array,
+    candidate: bool,
+    repeat: i32,
+    count: usize,
+) -> Result<Array> {
+    let mut value = input.try_clone()?;
+    for _ in 0..count {
+        value = if candidate {
+            hadamard(&value, slots, 53, repeat)?
+        } else {
+            value.hadamard_transform(Some(1.0 / 128.0f32.sqrt()))?
+        };
+    }
+    Ok(value)
+}
