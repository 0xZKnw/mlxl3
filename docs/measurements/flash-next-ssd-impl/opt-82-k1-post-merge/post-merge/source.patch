+/// Test-profile counterpart of the existing resident-slot GPU lookup.
+#[cfg(any(test, kani))]
+pub(crate) fn flash_hot_profile_slots(ids: &[u32], map: &[u32; 512]) -> Vec<u32> {
+    ids.iter()
+        .map(|&id| map.get(id as usize).copied().unwrap_or(u32::MAX))
+        .collect()
+}
+
+#[test]
+fn flash_hot_profile_preserves_order_duplicates_boundaries_and_absence() {
+    let mut map = [u32::MAX; 512];
+    map[0] = 7;
+    map[19] = 0;
+    map[511] = 52;
+    let pattern = [511, 0, 19, 1, 512, u32::MAX, 19];
+    let expected = [52, 7, 0, u32::MAX, u32::MAX, u32::MAX, 0];
+    for count in 0..=80 {
+        let ids = (0..count).map(|i| pattern[i % 7]).collect::<Vec<_>>();
+        let oracle = (0..count).map(|i| expected[i % 7]).collect::<Vec<_>>();
+        assert_eq!(flash_hot_profile_slots(&ids, &map), oracle);
+    }
+    assert_eq!(
+        flash_hot_profile_slots(&[0, 511], &[u32::MAX; 512]),
+        [u32::MAX, u32::MAX]
+    );
+}
+
+#[cfg(kani)]
+#[kani::proof]
+#[kani::unwind(513)]
+fn flash_hot_profile_lookup_matches_gpu_sentinel_for_all_u32_ids() {
+    let id: u32 = kani::any();
+    let map: [u32; 512] = kani::any();
+    let actual = flash_hot_profile_slots(&[id], &map);
+    assert_eq!(actual.len(), 1);
+    if id < 512 {
+        assert_eq!(actual[0], map[id as usize]);
+    } else {
+        assert_eq!(actual[0], u32::MAX);
+    }
+    kani::cover!(id == 0 && actual[0] == 0);
+    kani::cover!(id == 511 && actual[0] == 511);
+    kani::cover!(id < 512 && actual[0] == u32::MAX);
+    kani::cover!(id == 512);
+    kani::cover!(id == u32::MAX);
+}
+
+/// Only the exact Flash Half H128 layouts use the masked eight-thread kernel.
+#[cfg(any(feature = "mlx", test, kani))]
+pub(crate) fn flash_hot_h128_grid(
+    shape: &[i32],
+    slots: &[i32],
+    half: bool,
+    uint_slots: bool,
+    capacity: i32,
+    repeat: i32,
+) -> Option<[i32; 3]> {
+    let [rows, blocks, 128] = shape else {
+        return None;
+    };
+    let [routes] = slots else {
+        return None;
+    };
+    if !half
+        || !uint_slots
+        || !(1..=512).contains(&capacity)
+        || !(1..=80).contains(routes)
+        || !matches!(repeat, 1 | 2)
+        || !matches!(*blocks, 5 | 20)
+        || routes.checked_mul(repeat)? != *rows
+    {
+        return None;
+    }
+    Some([8, *blocks, *rows])
+}
+
+#[test]
+fn flash_hot_h128_accepts_only_bounded_flash_half_layouts() {
+    assert_eq!(
+        flash_hot_h128_grid(&[0, 5, 128], &[0], true, true, 53, 1),
+        None
+    );
+    let mut valid = 0;
+    for routes in 1..=80 {
+        for repeat in [1, 2] {
+            for blocks in [5, 20] {
+                for capacity in [1, 53, 512] {
+                    assert_eq!(
+                        flash_hot_h128_grid(
+                            &[routes * repeat, blocks, 128],
+                            &[routes],
+                            true,
+                            true,
+                            capacity,
+                            repeat
+                        ),
+                        Some([8, blocks, routes * repeat])
+                    );
+                    valid += 1;
+                }
+            }
+        }
+    }
+    assert_eq!(valid, 960);
+    for shape in [
+        vec![],
+        vec![128],
+        vec![20, 128],
+        vec![20, 5, 127],
+        vec![20, 5, 129],
+        vec![0, 5, 128],
+        vec![20, 4, 128],
+        vec![20, 5, 128, 1],
+        vec![i32::MAX, 20, 128],
+    ] {
+        assert!(flash_hot_h128_grid(&shape, &[20], true, true, 53, 1).is_none());
+    }
+    for slots in [vec![], vec![0], vec![-1], vec![81], vec![20, 1]] {
+        assert!(flash_hot_h128_grid(&[20, 5, 128], &slots, true, true, 53, 1).is_none());
+    }
+    for capacity in [-1, 0, 513, i32::MAX] {
+        assert!(flash_hot_h128_grid(&[20, 5, 128], &[20], true, true, capacity, 1).is_none());
+    }
+    for repeat in [-1, 0, 3, i32::MAX] {
+        assert!(flash_hot_h128_grid(&[20, 5, 128], &[20], true, true, 53, repeat).is_none());
+    }
+    assert!(flash_hot_h128_grid(&[20, 5, 128], &[20], false, true, 53, 1).is_none());
+    assert!(flash_hot_h128_grid(&[20, 5, 128], &[20], true, false, 53, 1).is_none());
+}
