+#[cfg(kani)]
+#[kani::proof]
+#[kani::unwind(17)]
+fn flash_hot_h128_grid_bounds_real_kernel_rows_and_offsets() {
+    let dims: [i32; 4] = kani::any();
+    let route_dims: [i32; 2] = kani::any();
+    let rank: usize = kani::any();
+    let route_rank: usize = kani::any();
+    kani::assume(rank <= 4);
+    kani::assume(route_rank <= 2);
+    let half: bool = kani::any();
+    let uint_slots: bool = kani::any();
+    let capacity: i32 = kani::any();
+    let repeat: i32 = kani::any();
+    let actual = flash_hot_h128_grid(
+        &dims[..rank],
+        &route_dims[..route_rank],
+        half,
+        uint_slots,
+        capacity,
+        repeat,
+    );
+    let expected = rank == 3
+        && route_rank == 1
+        && half
+        && uint_slots
+        && dims[2] == 128
+        && (dims[1] == 5 || dims[1] == 20)
+        && (1..=512).contains(&capacity)
+        && (1..=80).contains(&route_dims[0])
+        && (repeat == 1 || repeat == 2)
+        && i64::from(dims[0]) == i64::from(route_dims[0]) * i64::from(repeat);
+    assert_eq!(actual.is_some(), expected);
+    if let Some(grid) = actual {
+        assert_eq!(grid, [8, dims[1], dims[0]]);
+        assert!((1..=160).contains(&grid[2]));
+        let row: u32 = kani::any();
+        let block: u32 = kani::any();
+        let lane: u32 = kani::any();
+        let j: u32 = kani::any();
+        let r: u32 = kani::any();
+        kani::assume(row < grid[2] as u32 && block < grid[1] as u32 && lane < 8 && j < 4 && r < 4);
+        let offset = (row * grid[1] as u32 + block) * 128 + j * 32 + lane * 4 + r;
+        assert!(offset < grid[2] as u32 * grid[1] as u32 * 128);
+        assert!(offset < 409600);
+        assert!(row / (repeat as u32) < (route_dims[0] as u32));
+        kani::cover!(route_dims[0] == 20 && repeat == 2 && grid[1] == 20);
+        kani::cover!(
+            route_dims[0] == 80
+                && repeat == 2
+                && row == 159
+                && block == 19
+                && lane == 7
+                && j == 3
+                && r == 3
+        );
+        kani::cover!(capacity == 512 && repeat == 1 && route_dims[0] == 1);
+    }
+    kani::cover!(!expected && rank == 4);
+    kani::cover!(!expected && rank == 3 && !half);
+    kani::cover!(!expected && rank == 3 && capacity == 0);
+}
