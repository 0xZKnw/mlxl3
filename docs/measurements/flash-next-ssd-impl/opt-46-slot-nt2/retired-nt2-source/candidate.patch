+                        let value = |row: usize, col: usize| {
+                            ((row * 37 + col * 13) % 997) as f32 / 1024. - 0.5
+                        };
+                        let values = (0..rows)
+                            .flat_map(|r| (0..input).map(move |c| value(r, c)))
+                            .collect::<Vec<_>>();
+                        let x = if strided {
+                            let transposed = (0..input)
