+                                .collect::<Vec<_>>()
+                        };
+                        let su = scales(input);
+                        let sv = scales(output);
+                        let suh = Array::from_f16_bits(&su, &[rows as i32, input as i32])?;
+                        let svh = Array::from_f16_bits(&sv, &[rows as i32, output as i32])?;
+                        let before = Array::host_readbacks_for_test();
+                        let actual = expert_slots(
