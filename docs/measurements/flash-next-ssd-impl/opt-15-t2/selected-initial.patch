+fn project_rows(projection: &Projection, input: &Array) -> Result<Array> {
+    ensure!(input.shape().len() >= 2 && (1..=2).contains(&input.shape()[0]), "invalid Flash projection rows");
+    if input.shape()[0] == 1 || projection.is_exl3() {
+        return projection.forward(input);
+    }
+    // Dense GEMM changes the reference GEMV rounding; retain its row layout.
+    Array::concatenate(&[
+        &projection.forward(&input.slice(0, 0, 1)?)?,
+        &projection.forward(&input.slice(0, 1, 2)?)?,
+    ], 0)
+}
