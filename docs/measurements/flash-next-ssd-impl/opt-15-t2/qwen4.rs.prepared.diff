+    #[ignore = "physical Apple GPU and Flash checkpoint; exact HC pair and shape boundaries"]
+    fn flash_hc_pair_preserves_serial_rounding_and_rejects_invalid_shapes() -> Result<()> {
+        let c = crate::checkpoint::inspect(Path::new(&std::env::var("MLXL3_FLASH_MODEL")?))?;
+        let hc = Hc::load(&c, "model.language_model.layers.0.attn_hyper_connection", 1e-6, true)?;
+        let values = (0..2 * WIDTH).map(|i| (i as f32 * 0.017).sin()).collect::<Vec<_>>();
+        for dtype in [Dtype::Float16, Dtype::Float32] {
+            let input = Array::from_f32(&values, &[2, WIDTH])?.astype(dtype)?;
+            let a = hc.read(&input.slice(0, 0, 1)?)?;
+            let b = hc.read(&input.slice(0, 1, 2)?)?;
+            let (mixed, gate) = hc.read(&input)?;
+            let gate = gate.context("missing pair gate")?;
+            ensure!(mixed.shape() == [2, H] && gate.shape() == [2, HC]);
+            ensure!(mixed.to_f32()?.iter().all(|v| v.is_finite()));
+            ensure!(mixed.to_bytes()? == Array::concatenate(&[&a.0, &b.0], 0)?.to_bytes()?, "HC pair mixed differs");
+            ensure!(gate.to_bytes()? == Array::concatenate(&[&a.1.context("first gate")?, &b.1.context("second gate")?], 0)?.to_bytes()?, "HC pair gate differs");
+            let expected = Array::concatenate(&[
+                &Hc::write(&input.slice(0, 0, 1)?, &mixed.slice(0, 0, 1)?, &gate.slice(0, 0, 1)?)?,
+                &Hc::write(&input.slice(0, 1, 2)?, &mixed.slice(0, 1, 2)?, &gate.slice(0, 1, 2)?)?,
+            ], 0)?;
+            ensure!(Hc::write(&input, &mixed, &gate)?.to_bytes()? == expected.to_bytes()?, "HC pair write differs");
+            ensure!(Hc::write(&input, &mixed.slice(0, 0, 1)?, &gate).is_err());
+            ensure!(Hc::write(&input, &mixed, &gate.slice(0, 0, 1)?).is_err());
+        }
+        for shape in [vec![WIDTH], vec![0, WIDTH], vec![3, WIDTH], vec![1, WIDTH - 1]] {
+            ensure!(hc.read(&Array::zeros_dtype(&shape, Dtype::Float32)?).is_err());
+        }
+        Ok(())
+    }
