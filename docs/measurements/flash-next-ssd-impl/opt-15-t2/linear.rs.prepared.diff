+    fn flash_nt2_large_projections_are_exact_before_timing() -> anyhow::Result<()> {
+        use super::*;
+        use std::{path::Path, time::Instant};
+        let checkpoint =
+            crate::checkpoint::inspect(Path::new(&std::env::var("MLXL3_FLASH_MODEL")?))?;
+        let mut cases = Vec::new();
+        for prefix in [
+            "model.language_model.layers.0.mlp.shared_expert.down_proj",
+            "model.language_model.layers.0.linear_attn.in_proj_qkv",
+            "model.language_model.layers.0.linear_attn.in_proj_z",
+            "model.language_model.layers.0.linear_attn.out_proj",
+            "model.language_model.layers.3.self_attn.q_proj",
+            "model.language_model.layers.3.self_attn.o_proj",
+            "lm_head",
+            "mtp.fc_embedding",
+        ] {
+            let mut linear = Exl3Linear::from_checkpoint(&checkpoint, prefix)?;
+            ensure!(linear.reference_accumulation && !linear.mtp_hidden_batch);
+            ensure!(crate::flash_support::dense_output_tiles(linear.cols / 16) == 2);
+            let values = (0..linear.rows)
+                .map(|i| (i as f32 * 0.173).sin())
+                .collect::<Vec<_>>();
+            let x = Array::from_f32(&values, &[1, linear.rows])?;
+            linear.reference_nt_override = Some(1);
+            let expected = linear.forward(&x)?;
+            let values = expected.to_f32()?;
+            ensure!(values.len() == linear.cols as usize && values.iter().all(|v| v.is_finite()));
+            ensure!(values.iter().any(|v| *v != 0.0), "empty projection oracle");
+            let expected = expected.to_bytes()?;
+            linear.reference_nt_override = None;
+            ensure!(
+                linear.forward(&x)?.to_bytes()? == expected,
+                "NT2 projection differs {prefix}"
+            );
+            cases.push((prefix, linear, x));
+        }
+        ensure!(cases.len() == 8, "projection cases absent");
+        for (_, linear, x) in &mut cases {
+            for nt in [Some(1), None] {
+                linear.reference_nt_override = nt;
+                for _ in 0..2 {
+                    linear.forward(x)?.eval()?;
+                }
+            }
+        }
+        for (prefix, linear, x) in &mut cases {
+            let mut times = Vec::new();
+            for repeat in 0..5 {
+                let order = if repeat % 2 == 0 {
+                    [None, Some(1)]
+                } else {
+                    [Some(1), None]
+                };
+                for nt in order {
+                    linear.reference_nt_override = nt;
+                    let start = Instant::now();
+                    for _ in 0..32 {
+                        linear.forward(x)?.eval()?;
+                    }
+                    let ms = start.elapsed().as_secs_f64() * 1000.0 / 32.0;
+                    ensure!(ms.is_finite() && ms > 0.0);
+                    times.push(serde_json::json!({"repeat":repeat,"nt":nt.unwrap_or(2),"ms":ms}));
+                }
+            }
+            println!(
+                "FLASH_NT2_PROJECTION {}",
+                serde_json::json!({
+                    "status":"validated_microbenchmark", "prefix":prefix, "input":linear.rows,
+                    "output":linear.cols,"times":times,"parity":"all output bytes",
+                    "limit":"synthetic input and wall time; not generation throughput"
+                })
+            );
+        }
+        Ok(())
+    }
