+            let linear = Exl3Linear::from_checkpoint(&checkpoint, prefix)?;
+            ensure!(linear.reference_accumulation && !linear.mtp_hidden_batch);
+            let values = (0..linear.rows * 2)
+                .map(|i| (i as f32 * 0.173).sin())
+                .collect::<Vec<_>>();
+            let contiguous = Array::from_f32(&values, &[2, linear.rows])?;
+            let transposed = Array::from_f32(&values, &[linear.rows, 2])?.transpose(&[1, 0])?;
+            for input in [contiguous.try_clone()?, contiguous.astype(Dtype::Float16)?, transposed] {
+                let expected = Array::concatenate(&[
+                    &linear.forward(&input.slice(0, 0, 1)?)?,
+                    &linear.forward(&input.slice(0, 1, 2)?)?,
+                ], 0)?;
+                let actual = linear.forward(&input)?;
+                ensure!(actual.shape() == [2, linear.cols] && actual.dtype() == input.dtype());
+                let values = actual.to_f32()?;
+                ensure!(values.len() == 2 * linear.cols as usize && values.iter().all(|v| v.is_finite()));
+                ensure!(values.iter().any(|v| *v != 0.0), "empty T2 oracle");
+                ensure!(actual.to_bytes()? == expected.to_bytes()?, "T2 projection differs {prefix}");
+                ensure!(linear.forward(&input.reshape(&[1, 2, linear.rows])?)?.to_bytes()? == expected.to_bytes()?, "T2 leading shape differs");
+            }
+            ensure!(linear.forward(&Array::zeros_dtype(&[0, linear.rows], Dtype::Float16)?).is_err());
+            println!("T2 projection exact: {prefix}");
+        }
+        Ok(())
+    }
