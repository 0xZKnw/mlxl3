+    fn check_flash_gdn_prepare(qkv: &Array, history: &Array, weight: &Array) -> Result<()> {
+        let input = Array::concatenate(&[history, qkv], 1)?;
+        let expected_history = input.slice(1, 1, 4)?;
+        let conv = input
+            .astype(Dtype::Float32)?
+            .mul(&weight.transpose(&[2, 1, 0])?.astype(Dtype::Float32)?)?
+            .sum(1, true)?
+            .astype(Dtype::Float16)?
+            .silu()?;
+        let norm = |value: &Array, scale: f32| -> Result<Array> {
+            let eps = Array::from_f16_bits(&[f16::from_f32(1e-6).to_bits()], &[])?;
+            value
+                .mul(&value.mul(value)?.sum(3, true)?.add(&eps)?.rsqrt()?)?
+                .scalar_mul(scale)
+        };
+        let q = norm(
+            &conv.slice(2, 0, 2048)?.reshape(&[1, 1, 16, 128])?,
+            1. / 128f32.sqrt(),
+        )?;
+        let k = norm(&conv.slice(2, 2048, 4096)?.reshape(&[1, 1, 16, 128])?, 1.)?;
+        let v = conv.slice(2, 4096, 10240)?.reshape(&[1, 1, 48, 128])?;
+        let expected = [conv, q, k, v, expected_history];
+        let actual = flash_gdn_prepare(qkv, history, weight)?;
+        let mut count = 0;
+        for (i, (a, e)) in actual.iter().zip(&expected).enumerate() {
+            let values = a.astype(Dtype::Float32)?.to_f32()?;
+            ensure!(
+                a.shape() == e.shape()
+                    && a.dtype() == e.dtype()
+                    && !values.is_empty()
+                    && values.iter().all(|v| v.is_finite())
+                    && a.to_bytes()? == e.to_bytes()?,
+                "Flash fused GDN output {i} differs"
+            );
+            count += values.len();
+        }
+        ensure!(count == 51200, "incomplete Flash GDN output coverage");
+        Ok(())
+    }
