+    #[test]
+    #[ignore = "physical Apple GPU and Flash checkpoint; fused preparation and all state bytes"]
+    fn flash_fused_gdn_prepare_matches_chain_and_boundaries() -> Result<()> {
+        let c = crate::checkpoint::inspect(Path::new(&std::env::var("MLXL3_FLASH_MODEL")?))?;
+        let weight = half_weight(
+            &c,
+            "model.language_model.layers.2.linear_attn.conv1d.weight",
+            Some(&[10240, 1, 4]),
+        )?
+        .transpose(&[0, 2, 1])?;
+        let values = (0..40960)
+            .map(|i| ((i * 31 % 127) as f32 - 63.) / 64.)
+            .collect::<Vec<_>>();
+        for strided in [false, true] {
+            let (qkv, history) = if strided {
+                (
+                    Array::from_f32(&values[..20480], &[1, 10240, 2])?
+                        .astype(Dtype::Float16)?
+                        .transpose(&[0, 2, 1])?
+                        .slice(1, 0, 1)?,
+                    Array::from_f32(&values[..30720], &[1, 10240, 3])?
+                        .astype(Dtype::Float16)?
+                        .transpose(&[0, 2, 1])?,
+                )
+            } else {
+                (
+                    Array::from_f32(&values[..10240], &[1, 1, 10240])?.astype(Dtype::Float16)?,
+                    Array::from_f32(&values[..30720], &[1, 3, 10240])?.astype(Dtype::Float16)?,
+                )
+            };
+            check_flash_gdn_prepare(&qkv, &history, &weight)?;
+            check_flash_gdn_prepare(
+                &qkv,
+                &Array::zeros_dtype(&[1, 3, 10240], Dtype::Float16)?,
+                &weight,
+            )?;
+            ensure!(flash_gdn_prepare(&qkv.astype(Dtype::Float32)?, &history, &weight).is_err());
+            ensure!(flash_gdn_prepare(&qkv, &history.astype(Dtype::Float32)?, &weight).is_err());
+            ensure!(flash_gdn_prepare(&qkv, &history, &weight.astype(Dtype::Float32)?).is_err());
+            ensure!(flash_gdn_prepare(&qkv, &history.slice(1, 0, 2)?, &weight).is_err());
+            ensure!(flash_gdn_prepare(&qkv, &history, &weight.transpose(&[0, 2, 1])?).is_err());
+        }
+        for scale in [0.000001, 100.] {
+            let scaled = values.iter().map(|x| x * scale).collect::<Vec<_>>();
+            check_flash_gdn_prepare(
+                &Array::from_f32(&scaled[..10240], &[1, 1, 10240])?.astype(Dtype::Float16)?,
+                &Array::from_f32(&scaled[..30720], &[1, 3, 10240])?.astype(Dtype::Float16)?,
+                &weight,
+            )?;
+        }
+        let constant = |v, shape: &[i32]| -> Result<Array> {
+            Array::from_f32(&[v], &[1])?
+                .astype(Dtype::Float16)?
+                .broadcast_to(shape)
+        };
+        // The reference deliberately rounds the norm sum to half, even on overflow.
+        check_flash_gdn_prepare(
+            &constant(100., &[1, 1, 10240])?,
+            &constant(100., &[1, 3, 10240])?,
+            &constant(0.25, &[10240, 4, 1])?,
+        )?;
+        let zeros = Array::zeros_dtype(&[1, 1, 10240], Dtype::Float16)?;
+        let history = Array::zeros_dtype(&[1, 3, 10240], Dtype::Float16)?;
+        check_flash_gdn_prepare(&zeros, &history, &weight)?;
+        for shape in [
+            vec![2, 1, 10240],
+            vec![1, 0, 10240],
+            vec![1, 2, 10240],
+            vec![1, 1, 10239],
+            vec![10240],
+        ] {
+            ensure!(
+                flash_gdn_prepare(
+                    &Array::zeros_dtype(&shape, Dtype::Float16)?,
+                    &history,
+                    &weight
+                )
+                .is_err()
+            );
+        }
+        println!(
+            "Flash fused GDN: 8 cases, 409600 finite bit-exact output/state values, invalid tensors rejected"
+        );
+        Ok(())
+    }
