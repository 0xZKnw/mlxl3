+                )?;
+                ensure!(
+                    moe.batch_routes,
+                    "requires BATCH_ROUTES=1 through the real loader"
+                );
+                moe.gpu_hot = true;
+                moe.gpu_hot_wide = true;
+                moe.unique_cohorts = unique;
+                let x = Array::concatenate(
+                    &(0..rows).map(|r| &inputs[r % 3].0).collect::<Vec<_>>(),
