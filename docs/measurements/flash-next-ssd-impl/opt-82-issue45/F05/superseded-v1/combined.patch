+#[test]
+#[ignore = "physical Apple GPU; 48 real gates, scalar GEMV oracle and FP32 batch routes; run alone"]
+fn batch_routes_match_real_scalar_logits_probabilities_ids_and_weights() -> Result<()> {
+    let (checkpoint, root, reference) = fixture()?;
+    let mut cases = 0;
+    let mut fast_cases = 0;
+    for layer in 0..48 {
+        let prefix = format!("model.language_model.layers.{layer}.mlp");
+        let mut moe = SsdMoe::load(&checkpoint, &prefix, 20, true)?;
+        ensure!(
+            moe.batch_routes,
+            "requires BATCH_ROUTES=1 through the real loader"
+        );
+        let values = [0, 1]
+            .into_iter()
+            .map(|step| {
+                let bytes = semantic_bytes(
+                    &root,
+                    &reference["steps"][step]["components"][layer]["mlp"]["input"],
+                )?;
+                Ok(bytes
+                    .as_chunks::<4>()
+                    .0
+                    .iter()
+                    .map(|&b| f32::from_le_bytes(b))
+                    .collect::<Vec<_>>())
+            })
+            .collect::<Result<Vec<_>>>()?;
+        let widths: &[i32] = if layer == 0 {
+            &[1, 2, 3, 4, 5, 6, 7, 8]
+        } else {
+            &[1, 2, 3, 4, 8]
+        };
+        for resident in [false, true] {
+            if resident && layer != 0 {
+                continue;
+            }
+            moe.resident_gate = if resident {
+                Some(
+                    linear::checkpoint_array(&checkpoint, &format!("{prefix}.gate.weight"))?
+                        .astype(Dtype::Float16)?
+                        .transpose(&[1, 0])?
+                        .astype(Dtype::Float32)?,
+                )
+            } else {
+                None
+            };
+            for &rows in widths {
+                for dtype in [Dtype::Float16, Dtype::Float32] {
+                    for strided in [false, true] {
+                        let x = input(&values, rows, dtype, strided)?;
+                        let logits = (0..rows)
+                            .map(|r| moe.gate.forward(&x.slice(0, r, r + 1)?))
+                            .collect::<Result<Vec<_>>>()?;
+                        let probabilities = logits
+                            .iter()
+                            .map(Array::softmax_precise)
+                            .collect::<Result<Vec<_>>>()?;
+                        let serial_logits =
+                            Array::concatenate(&logits.iter().collect::<Vec<_>>(), 0)?;
+                        let serial_probabilities =
+                            Array::concatenate(&probabilities.iter().collect::<Vec<_>>(), 0)?;
+                        moe.route_gate_calls.set(0);
+                        let actual_logits = moe.gate_logits_rows(&x)?;
+                        ensure!(
+                            moe.route_gate_calls.get() == rows as usize,
+                            "scalar GEMV count changed"
+                        );
+                        ensure!(
+                            actual_logits.shape() == [rows, 512] && actual_logits.dtype() == dtype
+                        );
+                        ensure!(
+                            actual_logits.to_bytes()? == serial_logits.to_bytes()?,
+                            "gate logits differ layer={layer}"
+                        );
+                        let actual_probabilities = if dtype == Dtype::Float32 && rows > 1 {
+                            actual_logits.softmax_precise()?
+                        } else {
+                            let rows = (0..rows)
+                                .map(|r| actual_logits.slice(0, r, r + 1)?.softmax_precise())
+                                .collect::<Result<Vec<_>>>()?;
+                            Array::concatenate(&rows.iter().collect::<Vec<_>>(), 0)?
+                        };
+                        ensure!(
+                            actual_probabilities.to_bytes()? == serial_probabilities.to_bytes()?,
+                            "probabilities differ layer={layer}/B{rows}/{dtype:?}/strided={strided}/resident={resident}"
+                        );
+                        let pairs = (0..rows)
+                            .map(|r| moe.route(&x.slice(0, r, r + 1)?))
+                            .collect::<Result<Vec<_>>>()?;
+                        let expected_ids =
+                            Array::concatenate(&pairs.iter().map(|p| &p.0).collect::<Vec<_>>(), 0)?;
+                        let expected_weights =
+                            Array::concatenate(&pairs.iter().map(|p| &p.1).collect::<Vec<_>>(), 0)?;
+                        moe.route_gate_calls.set(0);
+                        moe.route_batch_calls.set(0);
+                        let (ids, weights) = moe.route_rows(&x)?;
+                        let fast = dtype == Dtype::Float32 && rows > 1;
+                        ensure!(
+                            moe.route_gate_calls.get() == rows as usize
+                                && moe.route_batch_calls.get() == usize::from(fast),
+                            "routing branch or scalar GEMV count changed"
+                        );
+                        ensure!(
+                            ids.shape() == [rows, 10]
+                                && weights.shape() == [rows, 10]
+                                && weights.dtype() == dtype
+                        );
+                        ensure!(
+                            ids.to_bytes()? == expected_ids.to_bytes()?
+                                && weights.to_bytes()? == expected_weights.to_bytes()?,
+                            "routes differ layer={layer}/B{rows}/{dtype:?}/strided={strided}/resident={resident}"
+                        );
+                        let p = serial_probabilities.to_f32()?;
+                        let ids = ids.to_u32()?;
+                        let weights = weights.to_f32()?;
+                        ensure!(p.len() == rows as usize * 512 && p.iter().all(|v| v.is_finite()));
+                        ensure!(
+                            ids.len() == rows as usize * 10
+                                && weights.len() == ids.len()
+                                && weights.iter().all(|v| v.is_finite())
+                        );
+                        for r in 0..rows as usize {
+                            let mut order = (0..512u32).collect::<Vec<_>>();
+                            order.sort_by(|&a, &b| {
+                                p[r * 512 + a as usize]
+                                    .total_cmp(&p[r * 512 + b as usize])
+                                    .then(a.cmp(&b))
+                            });
+                            ensure!(
+                                ids[r * 10..(r + 1) * 10] == order[502..],
+                                "independent CPU rank oracle differs"
+                            );
+                        }
+                        cases += 1;
+                        fast_cases += usize::from(fast);
+                    }
+                }
+            }
+        }
+        if layer == 0 {
+            let before = (
+                moe.hits,
+                moe.misses,
+                moe.read_bytes,
+                moe.route_gate_calls.get(),
+                moe.route_batch_calls.get(),
+            );
+            for shape in [
+                vec![],
+                vec![H],
+                vec![0, H],
+                vec![9, H],
+                vec![2, H - 1],
+                vec![1, 2, H],
