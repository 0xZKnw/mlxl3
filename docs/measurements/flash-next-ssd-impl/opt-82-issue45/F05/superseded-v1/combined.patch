+                )?;
+                let all_ids = (0..rows)
+                    .map(|r| moe.route(&x.slice(0, r as i32, r as i32 + 1)?)?.0.to_u32())
+                    .collect::<Result<Vec<_>>>()?
+                    .concat();
+                let prime = &all_ids[..5];
+                let routes = moe.cache.borrow_mut().reserve(prime)?;
+                let jobs = prime
+                    .iter()
+                    .zip(routes)
+                    .map(|(&id, (slot, _))| (id, slot))
+                    .collect::<Vec<_>>();
+                moe.fill_many(&jobs)?;
+                let mut claims = Vec::new();
+                for id in (0..512).filter(|id| !all_ids.contains(id)) {
+                    if claims.len() == pending {
+                        break;
+                    }
+                    claims.push((
