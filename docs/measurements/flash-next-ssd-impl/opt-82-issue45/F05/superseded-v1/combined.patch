+#[cfg(kani)]
+#[kani::proof]
+#[kani::unwind(5)]
+fn flash_route_batch_preserves_scalar_fallback_domain() {
+    let dimensions: [i32; 4] = kani::any();
+    let rank: usize = kani::any();
+    let fp32: bool = kani::any();
+    kani::assume(rank <= 4);
