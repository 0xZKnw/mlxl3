+use super::*;
+use serde_json::Value;
+use std::{fs, path::Path};
+
+fn fixture() -> Result<(Checkpoint, std::path::PathBuf, Value)> {
+    let checkpoint = crate::checkpoint::inspect(Path::new(&std::env::var("MLXL3_FLASH_MODEL")?))?;
+    let root = std::path::PathBuf::from(std::env::var("MLXL3_FLASH_REFERENCE")?);
+    let reference: Value = serde_json::from_reader(fs::File::open(root.join("reference.json"))?)?;
+    ensure!(reference["status"] == "complete" && reference["mode"] == "eval");
+    Ok((checkpoint, root, reference))
+}
+
+fn semantic_bytes(root: &Path, entry: &Value) -> Result<Vec<u8>> {
+    ensure!(entry["count"] == H, "invalid MoE fixture count");
+    let bytes = fs::read(root.join(entry["file"].as_str().context("missing fixture")?))?;
+    ensure!(
+        bytes.len() == H as usize * 4
+            && bytes
+                .as_chunks::<4>()
+                .0
+                .iter()
+                .all(|&v| f32::from_le_bytes(v).is_finite()),
+        "empty or nonfinite MoE fixture"
+    );
+    Ok(bytes)
+}
+
+fn input(values: &[Vec<f32>], rows: i32, dtype: Dtype, strided: bool) -> Result<Array> {
+    let data = if strided {
+        (0..H)
+            .flat_map(|column| {
+                (0..rows).map(move |row| values[row as usize % values.len()][column as usize])
+            })
+            .collect::<Vec<_>>()
+    } else {
+        (0..rows)
+            .flat_map(|row| values[row as usize % values.len()].iter().copied())
+            .collect()
+    };
+    let shape = if strided { [H, rows] } else { [rows, H] };
+    let value = Array::from_f32(&data, &shape)?.astype(dtype)?;
+    if strided {
+        value.transpose(&[1, 0])
+    } else {
+        Ok(value)
+    }
+}
