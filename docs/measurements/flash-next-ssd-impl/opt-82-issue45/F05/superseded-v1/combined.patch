+    assert_eq!(actual, expected);
+    kani::cover!(actual && dimensions[0] == 2);
+    kani::cover!(actual && dimensions[0] == 8);
+    kani::cover!(!actual && rank == 2 && dimensions[0] == 1 && dimensions[1] == 2560);
+    kani::cover!(!actual && rank == 2 && !fp32 && dimensions[0] == 2 && dimensions[1] == 2560);
+    kani::cover!(!actual && rank == 4);
+}
