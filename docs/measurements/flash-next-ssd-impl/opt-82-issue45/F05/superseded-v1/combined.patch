+#[test]
+#[ignore = "isolated environment and physical Apple GPU loader; run this test alone"]
+fn batch_route_flag_reaches_real_loader_and_rejects_invalid_literals() -> Result<()> {
+    const KEY: &str = "MLXL3_SSD_BATCH_ROUTES";
+    struct Restore(Option<std::ffi::OsString>);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            // This test is selected alone, with no concurrent environment readers.
+            unsafe {
+                match &self.0 {
+                    Some(v) => std::env::set_var(KEY, v),
+                    None => std::env::remove_var(KEY),
+                }
+            }
+        }
+    }
+    let _restore = Restore(std::env::var_os(KEY));
+    let checkpoint = crate::checkpoint::inspect(Path::new(&std::env::var("MLXL3_FLASH_MODEL")?))?;
+    for (value, expected) in [(None, false), (Some("0"), false), (Some("1"), true)] {
+        // SAFETY: the runbook selects only this test in this process.
+        unsafe {
+            match value {
+                Some(v) => std::env::set_var(KEY, v),
+                None => std::env::remove_var(KEY),
+            }
+        }
+        let moe = SsdMoe::load(&checkpoint, "model.language_model.layers.0.mlp", 20, true)?;
+        ensure!(
+            moe.batch_routes == expected,
+            "real loader ignored batch route option"
+        );
+    }
+    for value in ["", "2", "01", "true", " 1", "1\n"] {
+        unsafe { std::env::set_var(KEY, value) };
+        let error = SsdMoe::load(&checkpoint, "model.language_model.layers.0.mlp", 20, true)
+            .err()
+            .context("invalid batch route flag accepted")?;
+        ensure!(
+            error
+                .to_string()
+                .contains("MLXL3_SSD_BATCH_ROUTES must be 0 or 1")
+        );
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::ffi::OsStringExt;
+        unsafe { std::env::set_var(KEY, std::ffi::OsString::from_vec(vec![0xff])) };
+        ensure!(SsdMoe::load(&checkpoint, "model.language_model.layers.0.mlp", 20, true).is_err());
+    }
+    println!(
+        "FLASH_BATCH_ROUTE_FLAG default=0 valid=2 ascii_invalid=6 nonunicode_checked={} real_loader=true",
+        cfg!(unix)
+    );
+    Ok(())
+}
