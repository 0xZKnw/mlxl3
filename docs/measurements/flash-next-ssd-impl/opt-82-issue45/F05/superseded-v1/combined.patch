+            Ok((x, semantic_bytes(&root, &entry["output"])?))
+        })
+        .collect::<Result<Vec<_>>>()?;
+    let mut cases = 0;
+    for (capacity, pending) in [(20, 0), (53, 0), (53, 4)] {
+        for unique in [false, true] {
+            for rows in [1usize, 2, 3, 8] {
+                let mut moe = SsdMoe::load(
+                    &checkpoint,
+                    "model.language_model.layers.0.mlp",
+                    capacity,
