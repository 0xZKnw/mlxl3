+#[test]
+#[ignore = "physical Apple GPU; scalar/batched softmax+top10 edge contracts, no model"]
+fn batch_probability_rows_preserve_extremes_ties_and_nonfinite_bits() -> Result<()> {
+    let mut cases = 0;
+    for rows in [2, 3, 4, 8] {
+        for pattern in 0..7 {
+            let values = (0..rows * 512)
+                .map(|i| {
+                    let row = i / 512;
+                    let col = i % 512;
+                    match pattern {
+                        0 => {
+                            if (row + col) % 2 == 0 {
+                                0.
+                            } else {
+                                -0.
+                            }
+                        }
+                        1 => {
+                            if col == row + 1 {
+                                10000.
+                            } else {
+                                -10000.
+                            }
+                        }
+                        2 => ((col * 17 + row * 37) % 97) as f32 / 1048576.,
+                        3 => f32::NEG_INFINITY,
+                        4 => {
+                            if col == row {
+                                f32::from_bits(0x7fc00017)
+                            } else {
+                                col as f32 / 512.
+                            }
+                        }
+                        5 => {
+                            if col == row {
+                                f32::INFINITY
+                            } else {
+                                -1.
+                            }
+                        }
+                        6 => {
+                            if col < 10 + row {
+                                1.
+                            } else {
+                                f32::NEG_INFINITY
+                            }
+                        }
+                        _ => unreachable!(),
+                    }
+                })
+                .collect::<Vec<_>>();
+            let logits = Array::from_f32(&values, &[rows, 512])?;
+            let probabilities = (0..rows)
+                .map(|r| logits.slice(0, r, r + 1)?.softmax_precise())
+                .collect::<Result<Vec<_>>>()?;
+            let expected_p = Array::concatenate(&probabilities.iter().collect::<Vec<_>>(), 0)?;
+            let expected = probabilities
+                .iter()
+                .map(|p| router::topk(p, 10, true))
+                .collect::<Result<Vec<_>>>()?;
+            let expected_ids =
+                Array::concatenate(&expected.iter().map(|p| &p.0).collect::<Vec<_>>(), 0)?;
+            let expected_weights =
+                Array::concatenate(&expected.iter().map(|p| &p.1).collect::<Vec<_>>(), 0)?;
+            let actual_p = logits.softmax_precise()?;
+            let (actual_ids, actual_weights) = router::topk(&actual_p, 10, true)?;
+            ensure!(
+                actual_p.shape() == [rows, 512]
+                    && actual_ids.shape() == [rows, 10]
+                    && actual_weights.shape() == [rows, 10]
+            );
+            ensure!(
+                actual_p.to_bytes()? == expected_p.to_bytes()?,
+                "edge probabilities changed B{rows}/pattern{pattern}"
+            );
+            ensure!(
+                actual_ids.to_bytes()? == expected_ids.to_bytes()?
+                    && actual_weights.to_bytes()? == expected_weights.to_bytes()?,
+                "edge route bits changed B{rows}/pattern{pattern}"
+            );
+            cases += 1;
+        }
+    }
+    ensure!(cases == 28);
+    println!(
+        "FLASH_BATCH_ROUTE_EDGES cases={cases} probability_ids_weight_bits=exact nonfinite_historical_contract=true"
+    );
+    Ok(())
+}
