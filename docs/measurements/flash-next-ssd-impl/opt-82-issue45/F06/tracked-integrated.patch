+++ b/native/src/flash_support.rs
@@ -2493,3 +2493,47 @@ fn slot_read_segments_initialize_every_byte_before_publication() {
         }
     }
 }
+
+/// Only the Flash legacy top-10 may skip ranks already known to be losers.
+#[cfg(any(feature = "mlx", test, kani))]
+pub(crate) fn flash_top10_early_exit(experts: i32, top_k: usize, requested: bool) -> bool {
+    requested && experts == 512 && top_k == 10
+}
+
+#[cfg(test)]
+#[test]
+fn flash_top10_early_exit_never_changes_other_router_domains() {
+    for experts in [-1, 0, 1, 256, 511, 512, 513, 1024, i32::MAX] {
+        for top_k in [0, 1, 8, 9, 10, 11, 512, usize::MAX] {
+            assert!(!flash_top10_early_exit(experts, top_k, false));
+            if experts == 512 && top_k == 10 {
+                assert!(flash_top10_early_exit(experts, top_k, true));
+            } else {
+                assert!(!flash_top10_early_exit(experts, top_k, true));
+            }
+        }
+    }
+}
+
+#[cfg(kani)]
+#[kani::proof]
+fn flash_top10_early_exit_is_confined_to_requested_flash_geometry() {
+    let experts: i32 = kani::any();
+    let top_k: usize = kani::any();
+    let requested: bool = kani::any();
+    let enabled = flash_top10_early_exit(experts, top_k, requested);
+    if enabled {
+        assert!(requested);
+        assert_eq!(experts, 512);
+        assert_eq!(top_k, 10);
+    }
+    if !requested || experts != 512 || top_k != 10 {
+        assert!(!enabled);
+    } else {
+        assert!(enabled);
+    }
+    kani::cover!(enabled);
+    kani::cover!(requested && experts == 512 && top_k == 9 && !enabled);
+    kani::cover!(requested && experts == 511 && top_k == 10 && !enabled);
+    kani::cover!(!requested && experts == 512 && top_k == 10 && !enabled);
+}
