+
+#[cfg(kani)]
+#[kani::proof]
+#[kani::unwind(513)]
+fn actual_flash_top10_early_exit_preserves_a_symbolic_input() {
+    let bits: u32 = kani::any();
+    let value = f32::from_bits(bits);
+    let mut values = vec![1.; 512];
+    values[0] = value;
+    let input = Array::from_f32(&values, &[1, 512]).unwrap();
+    let old = flash_top10(&input, true, false).unwrap();
+    let new = flash_top10(&input, true, true).unwrap();
+    assert_eq!(new.0.to_u32().unwrap().len(), 10);
+    assert_eq!(new.0.to_u32().unwrap(), old.0.to_u32().unwrap());
+    assert_eq!(new.1.to_bytes().unwrap(), old.1.to_bytes().unwrap());
+    kani::cover!(bits == 0x8000_0000);
+    kani::cover!(bits == 0x7fc0_0000);
+    kani::cover!(bits == 0x4000_0000);
+}
