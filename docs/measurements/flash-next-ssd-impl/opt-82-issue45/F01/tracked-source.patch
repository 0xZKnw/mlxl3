+#[cfg(any(feature = "mlx", test, kani))]
+pub(crate) fn expert_qmv_half_output(
+    enabled: bool,
+    slot_major: bool,
+    raw: bool,
+    splits: i32,
+) -> bool {
+    enabled && slot_major && !raw && splits == 1
+}
+
+#[test]
+fn qmv_half_output_never_changes_raw_multisplit_or_ordinary_paths() {
+    for enabled in [false, true] {
+        for slot_major in [false, true] {
+            for raw in [false, true] {
+                for splits in [i32::MIN, -1, 0, 1, 2, 4, i32::MAX] {
+                    let actual = expert_qmv_half_output(enabled, slot_major, raw, splits);
+                    assert_eq!(
+                        actual,
+                        (enabled, slot_major, raw, splits) == (true, true, false, 1)
+                    );
+                }
+            }
+        }
+    }
+}
+
+#[cfg(kani)]
+#[kani::proof]
+fn qmv_half_output_preserves_raw_multisplit_and_slot_contract_for_all_inputs() {
+    let enabled: bool = kani::any();
+    let slot_major: bool = kani::any();
+    let raw: bool = kani::any();
+    let splits: i32 = kani::any();
+    let half = expert_qmv_half_output(enabled, slot_major, raw, splits);
+    if half {
+        assert!(enabled && slot_major && !raw);
+        assert_eq!(splits, 1);
+    }
+    if enabled && slot_major && !raw && splits == 1 {
+        assert!(half);
+    }
+    kani::cover!(half);
+    kani::cover!(enabled && raw && !half);
+    kani::cover!(enabled && splits == 2 && !half);
+    kani::cover!(enabled && !slot_major && !half);
+}
