+    #[kani::proof]
+    fn physical_hc_write_preserves_separate_rounding() {
+        let s = kani::any::<i8>() as f32 / 17.;
+        let b = kani::any::<i8>() as f32 / 31.;
+        let g = kani::any::<i8>() as f32 / 29.;
+        let streams = Array::from_f32(&[s], &[1, 1])
