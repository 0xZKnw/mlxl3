+    #[test]
+    #[ignore = "physical Apple GPU; HC separate rounding, strides and invalid metadata"]
+    fn flash_hc_write_preserves_cpu_rounding_and_rejects_invalid_tensors() -> Result<()> {
+        let input = |values: &[f32], dtype, strided| -> Result<Array> {
+            let n = i32::try_from(values.len())?;
+            if strided {
+                Array::from_f32(
+                    &values.iter().flat_map(|&v| [v, 123.]).collect::<Vec<_>>(),
+                    &[1, n, 2],
+                )?
+                .astype(dtype)?
+                .slice(2, 0, 1)?
+                .reshape(&[1, n])
+            } else {
+                Array::from_f32(values, &[1, n])?.astype(dtype)
+            }
+        };
+        let mut s = (0..WIDTH)
+            .map(|i| ((i * 31 % 997) - 498) as f32 / 37.)
+            .collect::<Vec<_>>();
+        let mut b = (0..H)
+            .map(|i| ((i * 17 % 991) - 495) as f32 / 113.)
+            .collect::<Vec<_>>();
+        s[0] = -1.;
+        b[0] = 1. + f32::EPSILON;
+        b[1] = 0.;
+        b[2] = -0.;
+        b[3] = 65504.;
+        b[4] = -65504.;
+        let g = [1. - f32::EPSILON, -1.2345, 0., 1.75];
+        let rounded = b[0] * g[0];
+        ensure!((s[0] + rounded).to_bits() != b[0].mul_add(g[0], s[0]).to_bits());
+        for dtype in [Dtype::Float16, Dtype::Float32] {
+            for strided in [false, true] {
+                let streams = input(&s, Dtype::Float32, strided)?;
+                let branch = input(&b, dtype, strided)?;
+                let gate = input(&g, Dtype::Float32, strided)?;
+                let expected = s
+                    .iter()
+                    .enumerate()
+                    .flat_map(|(i, &value)| {
+                        let branch = b[i % H as usize];
+                        let branch = if dtype == Dtype::Float16 {
+                            f16::from_f32(branch).to_f32()
+                        } else {
+                            branch
+                        };
+                        let product = branch * g[i / H as usize];
+                        (value + product).to_le_bytes()
+                    })
+                    .collect::<Vec<_>>();
+                let actual = Hc::write(&streams, &branch, &gate)?;
+                ensure!(actual.shape() == [1, WIDTH] && actual.dtype() == Dtype::Float32);
+                ensure!(actual.to_f32()?.iter().all(|v| v.is_finite()));
+                ensure!(
+                    actual.to_bytes()? == expected,
+                    "HC differs from CPU {dtype:?}/{strided}"
+                );
+                ensure!(
+                    actual.to_bytes()? == hc_write_graph(&streams, &branch, &gate)?.to_bytes()?,
+                    "HC differs from unfused MLX {dtype:?}/{strided}"
+                );
+                for invalid in [streams.reshape(&[WIDTH])?, streams.astype(Dtype::Float16)?] {
+                    ensure!(Hc::write(&invalid, &branch, &gate).is_err());
+                }
+                for invalid in [branch.slice(1, 0, H - 1)?, branch.astype(Dtype::UInt32)?] {
+                    ensure!(Hc::write(&streams, &invalid, &gate).is_err());
+                }
+                for invalid in [gate.reshape(&[HC])?, gate.astype(Dtype::Float16)?] {
+                    ensure!(Hc::write(&streams, &branch, &invalid).is_err());
+                }
+            }
+        }
+        Ok(())
+    }
