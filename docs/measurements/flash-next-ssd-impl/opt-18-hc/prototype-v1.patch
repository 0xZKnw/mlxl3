+            .broadcast_to(&[1, H])
+            .unwrap();
+        let gate = Array::from_f32(&[g], &[1, 1])
+            .unwrap()
+            .broadcast_to(&[1, HC])
+            .unwrap();
+        let product = b * g;
+        let output = Hc::write(&streams, &branch, &gate)
+            .unwrap()
+            .to_f32()
+            .unwrap();
+        assert_eq!(output.len(), WIDTH as usize);
+        assert!(
+            output
+                .iter()
+                .all(|v| v.to_bits() == (s + product).to_bits())
+        );
+    }
