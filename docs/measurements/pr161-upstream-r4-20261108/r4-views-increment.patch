+fn row_bindings_match_wide_arithmetic_without_overflow() {
+    let layout: MatrixLayout = MatrixLayout {
+        shape: kani::any(),
+        strides: kani::any(),
+        offset: kani::any(),
+    };
+    let item: u64 = kani::any();
+    let allocation: u64 = kani::any();
+    let actual = layout.row_byte_offset(item, allocation);
+    let end = (layout.offset.max(0) as u128 + u128::from(layout.shape[1])) * u128::from(item);
+    let valid = matches!(item, 2 | 4)
+        && layout.shape[0] == 1
+        && layout.shape[1] > 0
+        && layout.strides[1] == 1
+        && layout.offset >= 0
+        && end <= u128::from(allocation);
+    assert_eq!(actual.is_some(), valid);
+    if let Some(offset) = actual {
+        assert_eq!(u128::from(offset), layout.offset as u128 * u128::from(item));
+        assert!(
+            u128::from(offset) + u128::from(layout.shape[1]) * u128::from(item)
+                <= u128::from(allocation)
+        );
+        kani::cover!(offset > 0 && item == 2);
+        kani::cover!(item == 4 && layout.shape[1] == 10240);
+    }
+    kani::cover!(!valid && layout.offset < 0);
+    kani::cover!(!valid && layout.offset == i64::MAX && item == 4);
