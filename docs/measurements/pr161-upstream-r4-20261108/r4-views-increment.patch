 impl MatrixLayout {
+    /// Bind a nonempty contiguous row directly, including a row of packed storage.
+    #[cfg(any(all(target_os = "macos", feature = "direct-metal"), test, kani))]
+    pub(crate) fn row_byte_offset(&self, item: u64, allocation: u64) -> Option<u64> {
+        if !matches!(item, 2 | 4)
+            || self.shape[0] != 1
+            || self.shape[1] == 0
+            || self.strides[1] != 1
+        {
+            return None;
+        }
+        let offset = u64::try_from(self.offset).ok()?.checked_mul(item)?;
+        let bytes = u64::from(self.shape[1]).checked_mul(item)?;
+        (offset.checked_add(bytes)? <= allocation).then_some(offset)
+    }
