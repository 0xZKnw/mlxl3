+/// Experimental M3 geometry, restricted to the checkpoint shapes measured on M5.
+#[cfg(any(feature = "mlx", test, kani))]
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn qmv_grouped_batch_layout(
+    rows: i32,
+    input: i32,
+    output: i32,
+    k: usize,
+    mul1: bool,
+    m5: bool,
