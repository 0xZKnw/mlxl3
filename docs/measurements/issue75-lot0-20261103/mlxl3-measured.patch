+#[test]
+#[ignore = "physical Apple GPU and Flash checkpoint; isolated defaults or explicit overrides; run alone"]
+fn flash_dflash_projection_defaults_restore_loaded_overrides() -> Result<()> {
+    let checkpoint =
+        crate::checkpoint::inspect(std::path::Path::new(&std::env::var("MLXL3_FLASH_MODEL")?))?;
+    let batch = std::env::var("MLXL3_FLASH_MULTI_TOKEN").ok();
+    let mb34 = std::env::var("MLXL3_FLASH_REFERENCE_MB34").ok();
+    let roles = std::env::var("MLXL3_FLASH_REFERENCE_MB34_ROLES").ok();
+    let mut cases = 0;
+    for (name, role) in [
+        (
+            "model.language_model.layers.0.linear_attn.in_proj_qkv",
+            Some("qkv"),
+        ),
+        (
+            "model.language_model.layers.0.linear_attn.in_proj_z",
+            Some("z"),
+        ),
+        (
+            "model.language_model.layers.46.linear_attn.out_proj",
+            Some("out"),
+        ),
+        ("model.language_model.layers.3.self_attn.o_proj", None),
+        ("mtp.layers.0.self_attn.o_proj", None),
+        ("lm_head", None),
+    ] {
+        let selected =
+            |selection: &str| role.is_some_and(|role| selection == "all" || selection == role);
+        let baseline = (
+            batch.as_deref() == Some("1"),
+            mb34.as_deref() == Some("1") && selected(roles.as_deref().unwrap_or("qkv")),
+        );
+        let dflash = (
+            batch.as_deref() != Some("0"),
+            mb34.as_deref() != Some("0") && selected(roles.as_deref().unwrap_or("all")),
+        );
+        let mut linear = Exl3Linear::from_checkpoint(&checkpoint, name)?;
+        ensure!(
+            linear.settings_for_test() == baseline,
+            "load defaults differ: {name}"
+        );
+        let readbacks = Array::host_readbacks_for_test();
+        for enabled in [true, true, false, false, true, false] {
+            linear.set_flash_dflash_defaults(enabled);
+            ensure!(
+                linear.settings_for_test() == if enabled { dflash } else { baseline },
+                "projection defaults transition differs: {name}/{enabled}"
+            );
+        }
+        ensure!(Array::host_readbacks_for_test() == readbacks);
+        if cases == 0 {
+            let mut plain = Exl3Linear::new(
+                linear.trellis.try_clone()?,
+                linear.suh.try_clone()?,
+                linear.svh.try_clone()?,
+                None,
+                linear.k,
+                linear.cb,
+            )?;
+            for enabled in [true, false] {
+                plain.set_flash_dflash_defaults(enabled);
+                ensure!(plain.settings_for_test() == (false, false));
+            }
+            let mut projection =
+                crate::lfm2::Projection::load(&checkpoint, name, linear.rows, linear.cols, false)?;
+            for enabled in [true, false] {
+                projection.set_flash_dflash_defaults(enabled);
+                ensure!(projection.settings_for_test() == if enabled { dflash } else { baseline });
+            }
+        }
+        cases += 1;
+    }
+    ensure!(cases == 6);
+    println!(
+        "FLASH_DFLASH_PROJECTION_DEFAULTS projections=6 load_overrides=true restore=true no_readback=true plain_unchanged=true wrapper=true"
+    );
+    Ok(())
+}
