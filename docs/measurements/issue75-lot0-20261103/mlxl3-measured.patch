+    fn flash_top10_matches_legacy_cpu_and_boundaries() -> Result<()> {
+        let mut comparisons = 0;
+        for rows in [1] {
+            for dtype in [Dtype::Float16, Dtype::Float32] {
+                for fixture in 0..12 {
+                    let values = (0..rows * 512)
+                        .map(|i| match fixture {
+                            0 => 1.0,
+                            1 => {
+                                if i % 2 == 0 {
+                                    0.0
+                                } else {
+                                    -0.0
+                                }
+                            }
+                            2 => [
+                                f32::INFINITY,
+                                f32::NEG_INFINITY,
+                                f32::from_bits(0x7fc12345),
+                                f32::from_bits(0xffc12345),
+                                1.0,
+                                -1.0,
+                                0.0,
+                                -0.0,
+                            ][i as usize % 8],
+                            3 => 0.2 + ((i * 7) % 127) as f32 * 0.000001,
+                            4 => [
+                                f32::from_bits(1),
+                                f32::from_bits(0x80000001),
+                                0.0,
+                                -0.0,
+                                1.0e-5,
+                                -1.0e-5,
+                            ][i as usize % 6],
+                            5 => -1.0 - (i % 101) as f32,
+                            6 => 65504.0,
+                            _ => {
+                                (((i as u32)
+                                    .wrapping_mul(1664525)
+                                    .wrapping_add(fixture * 1013904223u32.wrapping_div(12)))
+                                    % 8192) as f32
+                                    / 4096.0
+                                    - 1.0
+                            }
+                        })
+                        .collect::<Vec<_>>();
+                    let input = Array::from_f32(&values, &[rows, 512])?.astype(dtype)?;
+                    let host = input.to_f32()?;
+                    let mut cpu_ids = Vec::new();
+                    for row in host.as_chunks::<512>().0 {
+                        let mut ids = (0..512u32).collect::<Vec<_>>();
+                        ids.sort_by(|&a, &b| {
+                            let (x, y) = (row[a as usize], row[b as usize]);
+                            match (x.is_nan(), y.is_nan()) {
+                                (true, true) => std::cmp::Ordering::Equal,
+                                (true, false) => std::cmp::Ordering::Greater,
+                                (false, true) => std::cmp::Ordering::Less,
+                                (false, false) => x.partial_cmp(&y).unwrap(),
+                            }
+                            .then(a.cmp(&b))
+                        });
+                        cpu_ids.extend_from_slice(&ids[502..]);
+                    }
+                    let transposed = input.transpose(&[1, 0])?;
+                    let copy = Array::from_bytes(&transposed.to_bytes()?, &[512, rows], dtype)?;
+                    let strided = copy.transpose(&[1, 0])?;
+                    for normalize in [false, true] {
+                        let old = topk_legacy(&input, 10, normalize)?;
+                        for x in [&input, &strided] {
+                            crate::flash_profile::start(false)?;
+                            let before = Array::host_readbacks_for_test();
+                            let built = topk(x, 10, normalize);
+                            let events = crate::flash_profile::finish()?;
+                            let new = built?;
+                            ensure!(
+                                Array::host_readbacks_for_test() == before,
+                                "router build performed host readback"
+                            );
+                            let events = serde_json::to_value(events)?;
+                            ensure!(
+                                events
+                                    .as_array()
+                                    .unwrap()
+                                    .iter()
+                                    .filter(|e| e["name"] == "flash_top10_simd_build")
+                                    .count()
+                                    == 1,
+                                "production dispatcher skipped SIMD top10"
+                            );
+                            assert_eq!(new.0.shape(), [rows, 10]);
+                            assert_eq!(new.1.shape(), [rows, 10]);
+                            assert_eq!(new.1.dtype(), dtype);
+                            assert_eq!(
+                                new.0.to_u32()?,
+                                cpu_ids,
+                                "CPU IDs {rows}/{dtype:?}/{fixture}"
+                            );
+                            assert_eq!(new.0.to_bytes()?, old.0.to_bytes()?);
+                            assert_eq!(
+                                new.1.to_bytes()?,
+                                old.1.to_bytes()?,
+                                "scores {rows}/{dtype:?}/{fixture}/{normalize}"
+                            );
+                            let scores = new.1.to_f32()?;
+                            assert_eq!(scores.len(), rows as usize * 10);
+                            if fixture != 1 && fixture != 2 {
+                                assert!(scores.iter().all(|v| v.is_finite()));
+                            }
+                            if !normalize && fixture != 2 {
+                                for (index, (&id, score)) in cpu_ids.iter().zip(&scores).enumerate()
+                                {
+                                    assert_eq!(
+                                        score.to_bits(),
+                                        host[index / 10 * 512 + id as usize].to_bits()
+                                    );
+                                }
+                            }
+                        }
+                        comparisons += 1;
+                    }
+                }
+            }
