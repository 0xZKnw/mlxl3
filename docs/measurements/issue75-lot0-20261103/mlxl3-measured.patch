@@ -0,0 +1,82 @@
+use super::*;
+
+#[test]
+#[ignore = "isolated environment, Flash checkpoint and physical Apple GPU; select alone"]
+fn dflash_defaults_preserve_load_time_overrides_and_restore() -> Result<()> {
+    let names = [
+        "MLXL3_SSD_GPU_HOT",
+        "MLXL3_SSD_GPU_HOT_WIDE",
+        "MLXL3_SSD_UNIQUE_COHORT",
+        "MLXL3_SSD_COLD_READY_ROWS",
+        "MLXL3_SSD_COLD_PRIORITY",
+        "MLXL3_SSD_ROUTED_INDEX_CACHE",
+    ];
+    let scenario = std::env::var("MLXL3_EXPECT_SSD_DEFAULTS")?;
+    let (requested, mask, initial, active) = match scenario.as_str() {
+        "unset" => (
+            [None; 6],
+            0u8,
+            (false, false, false, 2, false, false),
+            (true, true, true, 4, true, true),
+        ),
+        "off" => (
+            [
+                Some("0"),
+                Some("0"),
+                Some("0"),
+                Some("2"),
+                Some("0"),
+                Some("0"),
+            ],
+            63,
+            (false, false, false, 2, false, false),
+            (false, false, false, 2, false, false),
+        ),
+        "on" => (
+            [
+                Some("1"),
+                Some("1"),
+                Some("1"),
+                Some("4"),
+                Some("1"),
+                Some("1"),
+            ],
+            63,
+            (true, true, true, 4, true, true),
+            (true, true, true, 4, true, true),
+        ),
+        "mixed" => (
+            [Some("0"), None, Some("1"), Some("2"), None, Some("0")],
+            45,
+            (false, false, true, 2, false, false),
+            (false, true, true, 2, true, false),
+        ),
+        _ => anyhow::bail!("unknown SSD defaults fixture"),
+    };
+    for (name, expected) in names.into_iter().zip(requested) {
+        ensure!(
+            std::env::var_os(name).as_deref() == expected.map(std::ffi::OsStr::new),
+            "unexpected {name} fixture"
+        );
+    }
+    let checkpoint =
+        crate::checkpoint::inspect(std::path::Path::new(&std::env::var("MLXL3_FLASH_MODEL")?))?;
+    let mut moe = SsdMoe::load(&checkpoint, "model.language_model.layers.0.mlp", 53, true)?;
+    ensure!(moe.dflash_overrides == mask && moe.target_hot_scope);
+    ensure!(moe.execution_settings_for_test() == initial);
+    let readbacks = Array::host_readbacks_for_test();
+    for enabled in [true, true, false, false, true, false] {
+        moe.set_dflash_defaults(enabled);
+        ensure!(
+            moe.execution_settings_for_test() == if enabled { active } else { initial },
+            "SSD defaults differ for {scenario}, enabled={enabled}"
+        );
+        ensure!(moe.dflash_overrides == mask);
+        ensure!(moe.routed_indices.iter().all(Option::is_none));
+        ensure!(Array::host_readbacks_for_test() == readbacks);
+    }
+    println!(
+        "DFLASH_SSD_DEFAULTS scenario={scenario} transitions=6 loaded={initial:?} enabled={active:?} restored=true no_host_readbacks=true"
+    );
+    Ok(())
+}
