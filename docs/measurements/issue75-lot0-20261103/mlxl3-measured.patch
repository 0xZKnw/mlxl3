+use super::*;
+
+fn check_settings(target: &FlashNext, active: bool) -> Result<()> {
+    ensure!(target.multi_token == active);
+    ensure!(target.head.settings_for_test() == (active, false));
+    for layer in &target.layers {
+        ensure!(
+            layer.moe.execution_settings_for_test()
+                == (
+                    active,
+                    active,
+                    active,
+                    if active { 4 } else { 2 },
+                    active,
+                    active
+                )
+        );
+        if let Attention::Gdn(gdn) = &layer.attention {
+            for projection in [&gdn.qkv, &gdn.z, &gdn.out] {
+                ensure!(projection.settings_for_test() == (active, active));
+            }
+        }
+    }
+    Ok(())
+}
+
+#[test]
+#[ignore = "physical Apple GPU, target/draft fixtures; optimization controls absent; select alone"]
+fn default_dflash_configuration_restores_modes_errors_and_exact_states() -> Result<()> {
+    for name in [
+        "MLXL3_FLASH_MULTI_TOKEN",
+        "MLXL3_FLASH_REFERENCE_MB34",
+        "MLXL3_FLASH_REFERENCE_MB34_ROLES",
+        "MLXL3_FLASH_DRAFT_WIDTH",
+        "MLXL3_FLASH_DRAFT_ADAPTIVE",
+        "MLXL3_FLASH_DRAFT_PRECAP",
+        "MLXL3_SSD_GPU_HOT",
+        "MLXL3_SSD_GPU_HOT_WIDE",
+        "MLXL3_SSD_UNIQUE_COHORT",
+        "MLXL3_SSD_COLD_READY_ROWS",
+        "MLXL3_SSD_COLD_PRIORITY",
+        "MLXL3_SSD_ROUTED_INDEX_CACHE",
+    ] {
+        ensure!(
+            std::env::var_os(name).is_none(),
+            "test requires {name} absent"
+        );
+    }
+    let checkpoint = crate::checkpoint::inspect(Path::new(&std::env::var("MLXL3_FLASH_MODEL")?))?;
+    let draft = PathBuf::from(std::env::var("MLXL3_FLASH_DRAFT")?);
+    let mut target = FlashNext::from_checkpoint(&checkpoint)?;
+    check_settings(&target, false)?;
+    let serial = [EOS, 7, 19, 5, 11, 13, 17];
+    let saved = tempfile::tempdir()?;
+    let mut logits = Vec::new();
+    for (i, &token) in serial.iter().enumerate() {
+        let value = target.forward(token)?;
+        let finite = value.to_f32()?;
+        ensure!(value.shape() == [1, 248320]);
+        ensure!(finite.len() == 248320 && finite.iter().all(|v| v.is_finite()));
+        logits.push(value.to_bytes()?);
+        disk_state(&target, saved.path(), &format!("s{i}"), true)?;
+    }
+    for (mode, width) in [(1, 1), (2, 2), (3, 7), (1, 1)] {
+        target.configure_dflash2(Some(&draft), mode)?;
+        ensure!(target.dflash2_proposals() == Some(width));
+        check_settings(&target, true)?;
+    }
+    target.prefill_dflash2(&serial[..2], &AtomicBool::new(false))?;
+    let offset = target.offset();
+    target.configure_dflash2(Some(&draft), 1)?;
+    ensure!(
+        target.offset() == offset,
+        "unchanged configuration reset the session"
+    );
+    for retained in 1..=4 {
+        target.prefill_dflash2(&serial[..2], &AtomicBool::new(false))?;
+        let verification = target.verify_draft(&serial[2..6], Kind::Dflash2)?;
+        ensure!(verification.parts.logits.shape() == [4, 248320]);
+        ensure!(verification.parts.logits.to_bytes()? == logits[2..6].concat());
+        verification.commit(retained)?;
+        ensure!(disk_state(&target, saved.path(), &format!("s{}", 1 + retained), false)? == 136);
+        ensure!(target.forward(serial[2 + retained])?.to_bytes()? == logits[2 + retained]);
+        disk_state(&target, saved.path(), &format!("s{}", 2 + retained), false)?;
+    }
+    target.configure_dflash2(None, 1)?;
+    check_settings(&target, false)?;
+    target.reset();
+    for (i, &token) in serial[..3].iter().enumerate() {
+        ensure!(target.forward(token)?.to_bytes()? == logits[i]);
+    }
+    disk_state(&target, saved.path(), "s2", false)?;
+    for mode in [0, 4, usize::MAX] {
+        target.configure_dflash2(Some(&draft), 1)?;
+        ensure!(target.configure_dflash2(Some(&draft), mode).is_err());
+        ensure!(!target.dflash2_active() && target.offset() == 0);
+        check_settings(&target, false)?;
+    }
+    target.configure_dflash2(Some(&draft), 1)?;
+    ensure!(
+        target
+            .configure_dflash2(Some(&saved.path().join("missing")), 1)
+            .is_err()
+    );
+    ensure!(!target.dflash2_active() && target.offset() == 0);
+    check_settings(&target, false)?;
+    target.configure_dflash2(Some(&draft), 1)?;
+    ensure!(
+        target
+            .prefill_dflash2(&serial[..2], &AtomicBool::new(true))
+            .is_err()
+    );
+    ensure!(target.dflash2_active() && target.offset() == 0);
+    check_settings(&target, true)?;
+    ensure!(
+        target
+            .prefill_dflash2(&serial[..2], &AtomicBool::new(false))?
+            .to_bytes()?
+            == logits[1]
+    );
+    target.configure_dflash2(None, 1)?;
+    check_settings(&target, false)?;
+    println!(
+        "FLASH_DEFAULT_B2 proposals=1 modes=4 prefixes=4 logits_per_row=248320 states=136 overrides=absent restore=true errors=5 parity=byte_exact"
+    );
+    Ok(())
+}
+
+#[cfg(kani)]
+#[kani::proof]
+fn actual_default_dflash_profile_switch_and_verify_entry() {
+    default_dflash_configuration_restores_modes_errors_and_exact_states().unwrap();
+}
