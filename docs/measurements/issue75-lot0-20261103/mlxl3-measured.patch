+#[test]
+fn flash_top10_simd_domain_checks_every_boundary() {
+    for rows in [i32::MIN, -1, 0, 1, 2, 4, 8, 9, i32::MAX] {
+        for experts in [0, 256, 511, 512, 513, i32::MAX] {
+            for top_k in [0, 8, 9, 10, 11, usize::MAX] {
+                for floating in [false, true] {
+                    assert_eq!(
+                        flash_top10_simd_domain(rows, experts, top_k, floating),
+                        rows == 1 && experts == 512 && top_k == 10 && floating
+                    );
+                }
+            }
+        }
+    }
+}
+
+#[cfg(kani)]
+#[kani::proof]
+fn flash_top10_simd_domain_bounds_all_shader_indices() {
+    let rows: i32 = kani::any();
+    let experts: i32 = kani::any();
+    let top_k: usize = kani::any();
+    let floating: bool = kani::any();
+    let valid = flash_top10_simd_domain(rows, experts, top_k, floating);
+    assert!(valid == (rows == 1 && experts == 512 && top_k == 10 && floating));
+    if valid {
+        let row: u32 = kani::any();
+        let thread: u32 = kani::any();
+        let rank: u32 = kani::any();
+        let local: u32 = kani::any();
+        if row < rows as u32 && thread < 512 && rank < 10 && local < 5 {
+            let sg = thread / 32;
+            let lane = thread % 32;
+            assert!(sg * 10 + rank < 160 && lane + local * 32 < 160);
+            assert!(row * 512 + thread < (rows as u32) * 512);
+            assert!(row * 10 + 9 - rank < (rows as u32) * 10);
+        }
+    }
+    kani::cover!(valid && rows == 1);
+    kani::cover!(!valid && rows == 2);
+    kani::cover!(!valid && experts == 512 && rows == 9);
+}
