diff --git a/scripts/check_flash_options.py b/scripts/check_flash_options.py
new file mode 100644
index 0000000000000000000000000000000000000000..0e74ff9916f311bc4cd5679945b4e16aa1c864f9
--- /dev/null
+++ b/scripts/check_flash_options.py
@@ -0,0 +1,108 @@
+"""Check the production Flash option reader in isolated CPU-only libtest processes."""
+
+import argparse
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+TEST = "qwen4::draft::runtime::tests::option_environment_reaches_real_defaults_and_overrides"
+
+
+def cases():
+    checks = [
+        (1, {}, "1,0,0,1,1"),
+        (2, {}, "2,0,0,1,1"),
+        (3, {}, "7,0,0,1,1"),
+        (1, {"Q4": "0", "RING": "0"}, "1,0,0,0,0"),
+        (1, {"ADAPTIVE": "1"}, "7,1,0,1,1"),
+        (2, {"ADAPTIVE": "1"}, "2,0,0,1,1"),
+        (3, {"ADAPTIVE": "0"}, "7,0,0,1,1"),
+        (1, {"PRECAP": "1"}, "3,1,1,1,1"),
+        (2, {"PRECAP": "1"}, "2,0,0,1,1"),
+        (3, {"PRECAP": "1"}, "7,0,0,1,1"),
+        (1, {"WIDTH": "1"}, "1,0,0,1,1"),
+        (1, {"WIDTH": "3"}, "3,0,0,1,1"),
+        (1, {"WIDTH": "7"}, "7,0,0,1,1"),
+        (2, {"WIDTH": "1", "ADAPTIVE": "0"}, "1,0,0,1,1"),
+        (3, {"WIDTH": "3", "ADAPTIVE": "0"}, "3,0,0,1,1"),
+        (2, {"WIDTH": "1"}, "error"),
+        (3, {"WIDTH": "3"}, "error"),
+        (1, {"WIDTH": "3", "ADAPTIVE": "1"}, "error"),
+    ]
+    checks += [(mode, {"PRECAP": "1", "ADAPTIVE": "0"}, "error") for mode in (1, 2, 3)]
+    checks += [(mode, {}, "error") for mode in (0, 4, 2 * sys.maxsize + 1)]
+    for name in ("Q4", "RING", "ADAPTIVE", "PRECAP", "WIDTH"):
+        checks += [
+            (1, {name: value}, "error")
+            for value in ("", "8", "01", "+1", " 1", "1\n", "１", os.fsdecode(b"\xff"))
+        ]
+    checks += [(1, {"WIDTH": "0"}, "error")]
+    return checks
+
+
+def run(binary: Path, output: Path, timeout=15):
+    binary = binary.resolve(strict=True)
+    if not binary.is_file():
+        raise ValueError("test binary must be a file")
+    base = {k: v for k, v in os.environ.items() if not k.startswith("MLXL3_")}
+    report = {"status": "incomplete", "test_binary": str(binary), "checks": []}
+    output.parent.mkdir(parents=True, exist_ok=True)
+
+    def save():
+        output.write_text(json.dumps(report, indent=2) + "\n")
+
+    save()
+    try:
+        checks = cases()
+        if not checks:
+            raise ValueError("empty option matrix")
+        for mode, options, expected in checks:
+            env = base | {f"MLXL3_FLASH_DRAFT_{key}": value for key, value in options.items()}
+            env.update(MLXL3_EXPECTED_MODE=str(mode), MLXL3_EXPECTED_OPTIONS=expected)
+            record = {"mode": mode, "overrides": options, "expected": expected, "status": "running"}
+            report["checks"].append(record)
+            save()
+            # This test only reads options; subprocess.run kills and joins it on timeout.
+            child = subprocess.run(
+                [str(binary), TEST, "--exact", "--ignored", "--test-threads=1", "--nocapture"],
+                env=env,
+                capture_output=True,
+                text=True,
+                timeout=timeout,
+                check=False,
+            )
+            record.update(
+                returncode=child.returncode, output=child.stdout + child.stderr, joined=True
+            )
+            if (
+                child.returncode
+                or "test result: ok. 1 passed; 0 failed; 0 ignored;" not in record["output"]
+            ):
+                raise AssertionError("production option check failed or selected zero tests")
+            record["status"] = "passed"
+            save()
+        report["status"] = "passed"
+        save()
+        return report
+    except BaseException as error:
+        report["status"] = "interrupted" if isinstance(error, KeyboardInterrupt) else "failed"
+        report["error"] = f"{type(error).__name__}: {error}"
+        if report["checks"] and report["checks"][-1]["status"] == "running":
+            report["checks"][-1]["status"] = (
+                "timeout" if isinstance(error, subprocess.TimeoutExpired) else "failed"
+            )
+            if isinstance(error, (subprocess.TimeoutExpired, KeyboardInterrupt)):
+                report["checks"][-1]["joined"] = True
+        save()
+        raise
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--test-binary", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    result = run(args.test_binary, args.output)
+    print(f"Flash option reader: {len(result['checks'])} isolated CPU checks passed")
