+    pub(super) fn prepare_moe_projected(
+        &mut self,
+        streams: &MatrixView,
+        row: PreparedGdnRow,
+    ) -> Result<PreparedMoeRow> {
+        let before = self.snapshot();
+        let result = (|| {
+            let attention = self.attention.finish(row.pending)?;
+            self.residual
+                .prepare_after_attention(streams, row.read, attention)
+        })();
+        if result.is_err() {
+            self.restore(&before)?;
+        }
+        result
+    }
