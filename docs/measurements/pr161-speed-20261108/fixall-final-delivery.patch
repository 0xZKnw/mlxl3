+            self.protected = high;
+        } else {
+            // A fork/growth created inside the exclusive borrow has no external future snapshots.
+            state.slab.published.set(high);
+        }
+    }
+}
+impl Drop for VerificationPublication {
+    fn drop(&mut self) {
+        self.slab.published.set(self.protected);
+    }
