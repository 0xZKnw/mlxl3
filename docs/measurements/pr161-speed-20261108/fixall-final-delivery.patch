+            for (i, (read, projected)) in reads.iter().zip(&projections).enumerate() {
+                let step = self.attention.encode_for_consumer_prepared(
+                    cmd,
+                    read.mixed(),
+                    false,
+                    rows[i].dtype == FloatType::F32,
+                    Some(projected),
+                    pending.last().map(|p| &p.next),
+                )?;
+                pending.push(step);
+            }
+            Ok((reads, projections, pending))
