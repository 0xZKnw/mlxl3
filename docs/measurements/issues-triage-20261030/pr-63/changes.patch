+def inventory(names):
+    return {
+        "kani-version": "0.68.0",
+        "file-version": "0.1",
+        "standard-harnesses": {"real.rs": names},
+        "contract-harnesses": {},
+        "contracts": [],
+        "totals": {
+            "standard-harnesses": len(names),
+            "contract-harnesses": 0,
+            "functions-under-contract": 0,
+        },
+    }
+
