+def success(name, count=1):
+    return (
+        f"Checking harness {name}...\n ** 1 of 1 cover properties satisfied\n"
+        "VERIFICATION:- SUCCESSFUL\n"
+    ) * count + f"Complete - {count} successfully verified harnesses, 0 failures, {count} total.\n"
