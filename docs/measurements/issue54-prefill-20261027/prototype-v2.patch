 //! CPU contracts for Flash Next's disk rows and exact expert cache.
 use anyhow::Result;
 
+pub fn prefill_chunk(value: &str) -> Option<usize> {
+    match value {
+        "1" => Some(1),
+        "2" => Some(2),
+        "4" => Some(4),
+        "8" => Some(8),
+        _ => None,
+    }
+}
+
+#[test]
+fn prefill_chunk_accepts_only_qualified_geometries() {
+    for (s, n) in [("1", 1), ("2", 2), ("4", 4), ("8", 8)] {
+        assert_eq!(prefill_chunk(s), Some(n));
+    }
+    for s in ["", "0", "3", "16", "04", " 4", "4\n", "auto", "é"] {
+        assert_eq!(prefill_chunk(s), None);
+    }
+}
+
+#[cfg(kani)]
+#[kani::proof]
+#[kani::unwind(4)]
+fn prefill_chunk_parser_matches_independent_byte_oracle() {
+    let bytes: [u8; 2] = kani::any();
+    let length: usize = kani::any();
+    kani::assume(length <= 2);
+    if let Ok(value) = std::str::from_utf8(&bytes[..length]) {
+        let expected = if length == 1 && matches!(bytes[0], b'1' | b'2' | b'4' | b'8') {
+            Some((bytes[0] - b'0') as usize)
+        } else {
+            None
+        };
+        assert_eq!(prefill_chunk(value), expected);
+        kani::cover!(value == "4");
+        kani::cover!(prefill_chunk(value).is_none());
+    }
+}
+
