+                    })
+                    .collect::<Result<Vec<_>>>()?;
+                if capture_layers.contains(&index) {
+                    let rows = streams
+                        .iter()
+                        .map(mean_streams)
+                        .collect::<Result<Vec<_>>>()?;
+                    captures.push(Array::concatenate(&rows.iter().collect::<Vec<_>>(), 0)?);
+                }
+            }
+            ensure!(!cancelled.load(Ordering::Relaxed), "generation cancelled");
+            let hidden = streams.pop().context("empty prefill streams")?;
+            let logits = self.logits(&hidden)?;
+            let captured = if captures.is_empty() {
+                None
+            } else {
+                Some(Array::concatenate(&captures.iter().collect::<Vec<_>>(), 1)?)
+            };
+            if let Some(captured) = &captured {
+                captured.eval()?;
+                #[cfg(test)]
+                if let Some(trace) = &mut self.prefill_captures {
+                    trace.push(captured.try_clone()?);
+                }
+            }
+            self.drain()?;
+            self.last_hidden = Some(hidden);
+            self.offset += tokens.len() as i32;
+            Ok((logits, captured))
+        })();
+        if result.is_err() {
+            self.reset();
+        }
+        result
+    }
     pub fn reset(&mut self) {
+        #[cfg(test)]
+        if let Some(trace) = &mut self.prefill_captures {
+            trace.clear();
+        }
         for layer in &mut self.layers {
             layer.reset();
         }
