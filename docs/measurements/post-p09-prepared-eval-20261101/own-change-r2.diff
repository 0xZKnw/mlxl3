+#define NS_PRIVATE_IMPLEMENTATION
+#define MTL_PRIVATE_IMPLEMENTATION
+#include "prepared_metal.h"
+#include "mlx/fast.h"
+#include "mlx/ops.h"
+#include "mlx/transforms.h"
+#include <cassert>
+#include <cmath>
+#include <iostream>
+
+namespace mx = mlx::core;
+
+int main() {
+  assert(!mlxl3::prepared_metal_option(nullptr));
+  assert(!mlxl3::prepared_metal_option("0"));
+  assert(mlxl3::prepared_metal_option("1"));
+  for (const char* value : {"", "01", "true", "-1", "2", "1 "}) {
+    bool rejected = false;
+    try { mlxl3::prepared_metal_option(value); }
+    catch (const std::invalid_argument&) { rejected = true; }
+    assert(rejected);
+  }
+  const std::string source =
+      "uint i=thread_position_in_grid.x; if(i>=uint(x_shape[0]*x_shape[1])) return; "
+      "a[i]=x[i]+x_ndim+x_shape[1]+x_strides[1]; b[i]=x[i]*2;";
+  auto factory = mx::fast::metal_kernel("prepared_binding_test", {"x"}, {"a", "b"}, source);
+  std::shared_ptr<mlxl3::PreparedMetalPlan> plan;
+  std::vector<mx::array> pending;
+  std::vector<std::vector<float>> expected;
+  size_t cases = 0;
+  // Cross the constant/device boundary and keep old graphs alive across plan replacement.
+  for (int rows : {1, 2, 4, 8, 16, 32}) {
+    for (auto type : {mx::float16, mx::float32}) {
+      for (bool strided : {false, true}) {
+        for (int revision : {0, 1, 2}) {
+          std::vector<float> data(rows * 2);
+          for (int i = 0; i < rows * 2; ++i) data[i] = float(i + revision * 13) / 4;
+          auto x = mx::array(data.data(), {rows, 2});
+          if (strided) x = mx::transpose(mx::reshape(x, {2, rows}));
+          x = mx::astype(x, type);
+          const std::vector<mx::Dtype> types{type, type};
+          auto reference = factory({x}, {{rows, 2}, {rows, 2}}, types,
+                                   {rows * 2, 1, 1}, {32, 1, 1}, {}, {}, false, {});
+          auto actual = factory({x}, {{rows, 2}, {rows, 2}}, types,
+                                {rows * 2, 1, 1}, {32, 1, 1}, {}, {}, false, {});
+          int32_t grid[3]{rows * 2, 1, 1}, group[3]{32, 1, 1};
+          mlxl3::prepare_metal(actual, plan, types, grid, group);
+          assert(std::string(actual[0].primitive().name()) == "MLXL3PreparedMetal");
+          mx::eval(reference);
+          for (size_t out = 0; out < actual.size(); ++out) {
+            auto ref = mx::astype(reference[out], mx::float32);
+            ref.eval();
+            std::vector<float> oracle(ref.data<float>(), ref.data<float>() + ref.size());
+            assert(oracle.size() == data.size());
+            for (int i = 0; i < rows * 2; ++i) {
+              auto value = data[strided ? (i % 2) * rows + i / 2 : i];
+              assert(oracle[i] == (out == 0 ? value + 5 : value * 2));
+            }
+            pending.push_back(actual[out]);
+            expected.push_back(std::move(oracle));
+          }
+          ++cases;
+        }
+      }
+    }
+  }
+  // Evaluate after replacing input arrays/plans, then in reverse sibling order.
+  for (size_t i = pending.size(); i-- > 0;) {
+    auto value = mx::astype(pending[i], mx::float32);
+    value.eval();
+    assert(value.size() == expected[i].size());
+    for (size_t j = 0; j < value.size(); ++j)
+      assert(std::isfinite(value.data<float>()[j]) && value.data<float>()[j] == expected[i][j]);
+  }
+  auto scalar_factory = mx::fast::metal_kernel("prepared_scalar", {"x"}, {"y"}, "y[0]=x+3;");
+  std::shared_ptr<mlxl3::PreparedMetalPlan> scalar_plan;
+  for (float value : {1.f, 2.f, -3.f}) {
+    auto outputs = scalar_factory({mx::array(value)}, {{1}}, {mx::float32},
+                                   {1, 1, 1}, {1, 1, 1}, {}, {}, false, {});
+    int32_t grid[3]{1, 1, 1};
+    mlxl3::prepare_metal(outputs, scalar_plan, {mx::float32}, grid, grid);
+    assert(outputs[0].item<float>() == value + 3);
+  }
+  for (int dimension : {0, -1, INT32_MAX}) {
+    auto outputs = scalar_factory({mx::array(1.f)}, {{1}}, {mx::float32},
+                                   {1, 1, 1}, {1, 1, 1}, {}, {}, false, {});
+    int32_t grid[3]{1, 1, 1}, group[3]{dimension, dimension, dimension};
+    bool rejected = false;
+    try { mlxl3::prepare_metal(outputs, scalar_plan, {mx::float32}, grid, group); }
+    catch (const std::invalid_argument&) { rejected = true; }
+    assert(rejected);
+  }
+  std::cout << "PREPARED_QUALITY cases=" << cases << " outputs=" << pending.size()
+            << " scalar=3 invalid=3 exact=true\n";
+}
--- before/native/src/linear/prepared_tests.rs
+++ after/native/src/linear/prepared_tests.rs
@@ -0,0 +1,140 @@
+use super::*;
+use std::time::Instant;
+
+#[test]
+#[ignore = "physical Apple GPU; prepared eval component oracle then micro, run alone"]
+fn prepared_cold_chain_quality_and_micro() -> anyhow::Result<()> {
+    let prepared = std::env::var("MLXL3_PREPARED_METAL")?;
+    ensure!(prepared == "0" || prepared == "1");
+    let mut checked = 0;
+    for (input, output, projections) in [(2560usize, 640usize, 2usize), (640, 2560, 1)] {
+        let words = input / 16 * (output / 16) * 32;
+        let packed = (0..10 * projections * words)
+            .map(|i| (i as u16).wrapping_mul(1777))
+            .collect::<Vec<_>>();
+        let bank = Array::from_u16(
+            &packed,
+            &[
+                10,
+                projections as i32,
+                (input / 16) as i32,
+                (output / 16) as i32,
+                32,
+            ],
+        )?;
+        for routes_count in [1usize, 2, 4, 8, 16, 32] {
+            let routes = (0..routes_count)
+                .map(|r| (r % 10) as u32)
+                .collect::<Vec<_>>();
+            let slots = ExpertSlots::new(&routes, 10)?;
+            let rows = routes_count * projections;
+            let value = |r: usize, c: usize| ((r * 37 + c * 13) % 997) as f32 / 1024. - 0.5;
+            let values = (0..rows)
+                .flat_map(|r| (0..input).map(move |c| value(r, c)))
+                .collect::<Vec<_>>();
+            let scales = |width: usize| {
+                (0..rows * width)
+                    .map(|i| half::f16::from_f32(0.5 + (i % 11) as f32 / 32.).to_bits())
+                    .collect::<Vec<_>>()
+            };
+            let su = scales(input);
+            let sv = scales(output);
+            let suh = Array::from_f16_bits(&su, &[rows as i32, input as i32])?;
+            let svh = Array::from_f16_bits(&sv, &[rows as i32, output as i32])?;
+            for dtype in [Dtype::Float16, Dtype::Float32] {
+                let mut expected = Vec::new();
+                for row in 0..rows {
+                    let index =
+                        routes[row / projections] as usize * projections + row % projections;
+                    let mut reference = Exl3Linear::new(
+                        Array::from_u16(
+                            &packed[index * words..(index + 1) * words],
+                            &[(input / 16) as i32, (output / 16) as i32, 32],
+                        )?,
+                        Array::from_f16_bits(&su[row * input..(row + 1) * input], &[input as i32])?,
+                        Array::from_f16_bits(
+                            &sv[row * output..(row + 1) * output],
+                            &[output as i32],
+                        )?,
+                        None,
+                        2,
+                        Codebook::Mul1,
+                    )?;
+                    reference.simdgroups = 4;
+                    reference.reference_accumulation = true;
+                    let x = Array::from_f32(
+                        &values[row * input..(row + 1) * input],
+                        &[1, input as i32],
+                    )?
+                    .astype(dtype)?;
+                    expected.extend(reference.forward(&x)?.to_bytes()?);
+                }
+                for strided in [false, true] {
+                    let x = if strided {
+                        let transposed = (0..input)
+                            .flat_map(|c| (0..rows).map(move |r| value(r, c)))
+                            .collect::<Vec<_>>();
+                        Array::from_f32(&transposed, &[input as i32, rows as i32])?
+                            .astype(dtype)?
+                            .transpose(&[1, 0])?
+                    } else {
+                        Array::from_f32(&values, &[rows as i32, input as i32])?.astype(dtype)?
+                    };
+                    let make = || {
+                        expert_slots(
+                            &x,
+                            &bank,
+                            &suh,
+                            &svh,
+                            &slots,
+                            output as i32,
+                            projections as i32,
+                            2,
+                            Codebook::Mul1,
+                            false,
+                        )
+                    };
+                    let y = make()?;
+                    ensure!(y.shape() == [rows as i32, output as i32]);
+                    let floats = y.to_f32()?;
+                    ensure!(floats.len() == rows * output && floats.iter().all(|v| v.is_finite()));
+                    ensure!(
+                        y.to_bytes()? == expected,
+                        "prepared Cold differs from independent single-row projection"
+                    );
+                    checked += 1;
+                    if strided || dtype != Dtype::Float32 {
+                        continue;
+                    }
+                    for _ in 0..8 {
+                        make()?.eval()?;
+                    }
+                    for batch in 0..8 {
+                        let mut times = [0.0f64; 3];
+                        for _ in 0..32 {
+                            let t = Instant::now();
+                            let y = make()?;
+                            times[0] += t.elapsed().as_secs_f64();
+                            let t = Instant::now();
+                            y.async_eval()?;
+                            times[1] += t.elapsed().as_secs_f64();
+                            let t = Instant::now();
+                            y.eval()?;
+                            times[2] += t.elapsed().as_secs_f64();
+                            ensure!(y.to_bytes()? == expected, "micro output diverged");
+                        }
+                        eprintln!(
+                            "PREPARED_MICRO flag={prepared} input={input} output={output} routes={routes_count} rows={rows} batch={batch} calls=32 build_us={} submit_us={} wait_us={}",
+                            times[0] * 1e6 / 32.,
+                            times[1] * 1e6 / 32.,
+                            times[2] * 1e6 / 32.
+                        );
+                    }
+                }
+            }
+        }
+    }
+    ensure!(checked == 48);
+    eprintln!("PREPARED_CHAIN_QUALITY cases={checked} exact=true");
+    Ok(())
+}
