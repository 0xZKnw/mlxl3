 const PRIOR: [f64; 8] = [0.7, 0., -0.35, -0.8, -0.75, -0.75, -0.85, -0.45];
 
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum DraftAction {
+    Calibrate,
+    Draft,
+    Plain,
+}
+
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub(crate) struct OffBudget {
+    plain: [u64; 3],
+    draft: [u64; 3],
+    plain_count: usize,
+    draft_count: usize,
+    next: usize,
+    stopped: bool,
+}
+
+impl OffBudget {
+    pub(crate) fn action(&self) -> DraftAction {
+        if self.stopped {
+            DraftAction::Plain
+        } else if self.plain_count < 3 {
+            DraftAction::Calibrate
+        } else {
+            DraftAction::Draft
+        }
+    }
+    pub(crate) fn observe_plain(&mut self, nanos: u64) -> Option<()> {
+        if nanos == 0 || self.plain_count == 3 {
+            return None;
+        }
+        self.plain[self.plain_count] = nanos;
+        self.plain_count += 1;
+        Some(())
+    }
+    pub(crate) fn observe_draft(&mut self, nanos: u64, emitted: usize) -> Option<()> {
+        if nanos == 0 || !(1..=8).contains(&emitted) || self.plain_count != 3 || self.stopped {
+            return None;
+        }
+        let cost = (u128::from(nanos).div_ceil(emitted as u128)) as u64;
+        self.draft[self.next] = cost;
+        self.next = (self.next + 1) % 3;
+        self.draft_count = (self.draft_count + 1).min(3);
+        if self.draft_count == 3 {
+            let (mut plain, mut draft) = (self.plain, self.draft);
+            plain.sort_unstable();
+            draft.sort_unstable();
+            // shortcut: calibrates once per request; revisit for large context changes.
+            self.stopped = u128::from(draft[1]) * 100 > u128::from(plain[1]) * 105;
+        }
+        Some(())
+    }
+}
+
+#[cfg(test)]
+#[test]
+fn off_budget_prices_emitted_tokens_and_stops_before_the_next_draft() {
+    for (cost, expected) in [(105, DraftAction::Draft), (106, DraftAction::Plain)] {
+        let mut budget = OffBudget::default();
+        assert_eq!(budget.action(), DraftAction::Calibrate);
+        assert_eq!(budget.observe_draft(100, 2), None);
+        let before = budget.clone();
+        assert_eq!(budget.observe_plain(0), None);
+        assert_eq!(budget, before);
+        for _ in 0..3 {
+            assert_eq!(budget.observe_plain(100), Some(()));
+        }
+        assert_eq!(budget.action(), DraftAction::Draft);
+        for _ in 0..3 {
+            assert_eq!(budget.observe_draft(cost * 2, 2), Some(()));
+        }
+        assert_eq!(budget.action(), expected);
+        let before = budget.clone();
+        assert_eq!(budget.observe_draft(100, 0), None);
+        assert_eq!(budget, before);
+        assert_eq!(budget.observe_draft(100, usize::MAX), None);
+        assert_eq!(budget, before);
+    }
+    let mut budget = OffBudget::default();
+    for _ in 0..3 {
+        budget.observe_plain(u64::MAX).unwrap();
+    }
+    for _ in 0..3 {
+        budget.observe_draft(u64::MAX, 8).unwrap();
+    }
+    assert_eq!(budget.action(), DraftAction::Draft);
+}
+
+#[cfg(kani)]
+#[kani::proof]
+#[kani::unwind(10)]
+fn off_budget_prices_full_width_costs_without_overflow_and_rejects_atomically() {
+    let plain: u64 = kani::any();
+    let nanos: u64 = kani::any();
+    let emitted: usize = kani::any();
+    let mut budget = OffBudget::default();
+    for _ in 0..3 {
+        let result = budget.observe_plain(plain);
+        assert_eq!(result.is_some(), plain > 0);
+    }
+    let before = budget.clone();
+    let valid = plain > 0 && nanos > 0 && (1..=8).contains(&emitted);
+    let result = budget.observe_draft(nanos, emitted);
+    assert_eq!(result.is_some(), valid);
+    if valid {
+        budget.observe_draft(nanos, emitted).unwrap();
+        budget.observe_draft(nanos, emitted).unwrap();
+        let cost = (u128::from(nanos) + emitted as u128 - 1) / (emitted as u128);
+        assert_eq!(
+            budget.action() == DraftAction::Plain,
+            cost * 100 > u128::from(plain) * 105
+        );
+        kani::cover!(budget.action() == DraftAction::Plain);
+        kani::cover!(budget.action() == DraftAction::Draft);
+    } else {
+        assert_eq!(budget, before);
+        kani::cover!(emitted == usize::MAX);
+    }
+}
