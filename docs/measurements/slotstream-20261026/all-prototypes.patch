+#[cfg(kani)]
+#[kani::proof]
+#[kani::unwind(34)]
+fn complete_prompt_checkpoint_cannot_reuse_a_partial_or_empty_prefix() {
+    let saved: [u32; 8] = kani::any();
+    let next: [u32; 8] = kani::any();
+    let a: u8 = kani::any();
+    let b: u8 = kani::any();
+    kani::assume(a <= 8 && b <= 8);
+    let (a, b) = (usize::from(a), usize::from(b));
+    let reusable = complete_prompt_prefix(&saved[..a], &next[..b]);
+    let mut expected = a > 0 && a <= b;
+    for i in 0..a.min(b) {
+        expected &= saved[i] == next[i];
+    }
+    assert_eq!(reusable, expected);
+    kani::cover!(reusable && a == 8);
+    kani::cover!(!reusable && a > b);
+    kani::cover!(!reusable && a == 0);
+}
