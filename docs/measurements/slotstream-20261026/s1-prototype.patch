+/// A PLE row is a circular stream of 160 four-bit symbols and one FP16 scale.
+pub fn decode_ngram_row(words: &[u16], bias: &[f16], output: &mut Vec<u16>) -> Result<()> {
+    ensure!(
+        words.len() == 41 && bias.len() == 160,
+        "invalid PLE row shape"
+    );
+    let scale = f16::from_bits(words[0]).to_f32();
+    ensure!(scale.is_finite(), "nonfinite PLE row scale");
+    for (i, bias) in bias.iter().enumerate() {
+        let mut state = 0u16;
+        for j in 0..4 {
+            let symbol = (i + 160 - j) % 160;
+            state |= ((words[1 + symbol / 4] >> (4 * (symbol % 4))) & 15) << (j * 4);
+        }
+        let value =
+            f16::from_f32(decode_codeword(state, Codebook::Mul1).to_f32() * scale + bias.to_f32());
+        ensure!(value.is_finite(), "nonfinite PLE embedding");
+        output.push(value.to_bits());
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod ngram_tests {
+    use super::*;
+
+    fn decode(words: &[u16], bias: &[f16]) -> Result<Vec<u16>> {
+        let mut result = Vec::new();
+        decode_ngram_row(words, bias, &mut result)?;
+        Ok(result)
+    }
+
+    #[test]
+    fn circular_rows_match_independent_symbol_windows_and_reject_invalid_values() {
+        let mut seed = 17u32;
+        for scale in [0., 0.25, -0.5, 1., 2.] {
+            for _ in 0..32 {
+                let mut words = [0u16; 41];
+                words[0] = f16::from_f32(scale).to_bits();
+                for word in &mut words[1..] {
+                    seed = seed.wrapping_mul(1664525).wrapping_add(1013904223);
+                    *word = (seed >> 16) as u16;
+                }
+                let bias: Vec<_> = (0..160)
+                    .map(|i| f16::from_f32((i as f32 - 80.) / 512.))
+                    .collect();
+                let symbols: Vec<_> = words[1..]
+                    .iter()
+                    .flat_map(|w| (0..4).map(move |i| (w >> (4 * i)) & 15))
+                    .collect();
+                let mut history = symbols[157..].to_vec();
+                history.extend(&symbols);
+                let expected: Vec<_> = history
+                    .windows(4)
+                    .zip(&bias)
+                    .map(|(w, b)| {
+                        let state = w[0] * 4096 + w[1] * 256 + w[2] * 16 + w[3];
+                        f16::from_f32(
+                            decode_codeword(state, Codebook::Mul1).to_f32() * scale + b.to_f32(),
+                        )
+                        .to_bits()
+                    })
+                    .collect();
+                assert_eq!(decode(&words, &bias).unwrap(), expected);
+            }
+        }
+        let mut words = [0u16; 41];
+        let mut bias = [f16::ZERO; 160];
+        assert!(decode(&words[..40], &bias).is_err());
+        assert!(decode(&words, &bias[..159]).is_err());
+        for scale in [f16::NAN, f16::INFINITY, f16::NEG_INFINITY] {
+            words[0] = scale.to_bits();
+            assert!(decode(&words, &bias).is_err());
+        }
+        words[0] = f16::ONE.to_bits();
+        bias[159] = f16::NAN;
+        assert!(decode(&words, &bias).is_err());
+        bias.fill(f16::MAX);
+        let symbol = (0..16u16)
+            .find(|s| decode_codeword(s * 0x1111, Codebook::Mul1).to_f32() > 0.01)
+            .unwrap();
+        words.fill(symbol * 0x1111);
+        words[0] = f16::MAX.to_bits();
+        assert!(decode(&words, &bias).is_err());
+    }
+}
+
+#[cfg(kani)]
+#[kani::proof]
+#[kani::unwind(162)]
+fn ple_row_decoder_rejects_nonfinite_or_returns_exact_finite_shape() {
+    let mut words = [0u16; 41];
+    words[0] = kani::any();
+    words[1] = kani::any();
+    let mut values = Vec::new();
+    let result = decode_ngram_row(&words, &[f16::ZERO; 160], &mut values);
+    if result.is_ok() {
+        assert_eq!(values.len(), 160);
+        assert!(values.into_iter().all(|v| f16::from_bits(v).is_finite()));
+        kani::cover!(words[0] == f16::ONE.to_bits());
+    } else {
+        kani::cover!(words[0] == f16::INFINITY.to_bits());
+    }
+}
