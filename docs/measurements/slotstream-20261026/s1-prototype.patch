+            target.reset();
+            let ple = target
+                .layers
+                .iter_mut()
+                .find_map(|l| l.ple.as_mut())
+                .context("missing PLE")?;
+            if ple.rows.decoded != decoded {
+                ple.rows.cache.clear();
+                ple.rows.queue.clear();
+            }
+            ple.rows.decoded = decoded;
+            let before = ple.rows.read_bytes;
+            for (step, token) in [EOS, 1, 42, EOS, 7, 7].into_iter().enumerate() {
+                let logits = target.forward(token)?;
