+def _batch_group_global_scales(
+    bases: Sequence[LayerQuantizationBasis],
+    *,
+    k: int,
+    cb: CodebookMode,
+) -> list[LayerQuantizationBasis]:
+    """Choose expert global scales with two Metal batches instead of 13 syncs each."""
+
+    import mlx.core as mx
+
+    fixed_scale = os.environ.get("PONYEXL3_FIXED_EXPERT_SCALE")
+    if fixed_scale is not None:
+        result = GlobalScaleSearchResult(
+            scale=float(fixed_scale), mse=float("nan"), evaluations=0
+        )
+        out = []
+        for basis in bases:
+            regularized = apply_global_scale(
+                RegularizedWeights(
+                    inner=basis.target_inner,
+                    suh=basis.suh,
+                    svh=basis.svh,
+                    stats=basis.stats,
+                ),
+                result,
+            )
+            stats = dict(regularized.stats)
+            stats["regularize_g_scale_skipped"] = False
+            out.append(
+                LayerQuantizationBasis(
+                    source_public=basis.source_public,
+                    target_inner=regularized.inner,
+                    suh=regularized.suh,
+                    svh=regularized.svh,
+                    stats=stats,
+                )
+            )
+        return out
+
+    samples = [sample_tile_matrix(basis.target_inner).reshape(-1, 16) for basis in bases]
+    if len({sample.shape for sample in samples}) != 1:
+        raise LDLQGroupIncompatible("batched global-scale samples differ in shape")
+
+    def evaluate(scales: list[list[float]], tile_sets: list[np.ndarray]) -> np.ndarray:
+        pairs = [(index, scale) for index, values in enumerate(scales) for scale in values]
+        source = mx.array(
+            np.stack([tile_sets[index] for index, _scale in pairs]), dtype=mx.float32
+        )
+        factors = mx.array([scale for _index, scale in pairs], dtype=mx.float32).reshape(-1, 1, 1)
+        rows = source.shape[1]
+        scaled = (source * factors).reshape(len(pairs) * rows, 16)
+        _packed, reconstructed = quantize_inner_matrix_direct_mlx(scaled, k=k, cb=cb)
+        reconstructed = reconstructed.reshape(len(pairs), rows, 16)
+        mse = mx.mean((reconstructed / factors - source) ** 2, axis=(1, 2))
+        mx.eval(mse)
+        return np.array(mse).astype(np.float64, copy=False)
+
+    coarse = [[0.1 + 0.2 * index for index in range(10)] for _basis in bases]
+    subsamples = [
+        sample.reshape(-1, 16, 16)[::3].reshape(-1, 16) for sample in samples
+    ]
+    coarse_mse = evaluate(coarse, subsamples).reshape(len(bases), 10)
+    centers = [coarse[int(np.argmin(row))] for coarse, row in zip(coarse, coarse_mse)]
+    fine = [[center + 0.075 * (index - 2) for index in range(5)] for center in centers]
+    fine_mse = evaluate(fine, samples).reshape(len(bases), 5)
+
+    results: list[GlobalScaleSearchResult] = []
+    for scales, errors in zip(fine, fine_mse):
+        best = int(np.argmin(errors))
+        offset = 0.0
+        if 0 < best < 4:
+            y0, y1, y2 = (float(errors[best - 1]), float(errors[best]), float(errors[best + 1]))
+            denom = y0 - 2.0 * y1 + y2
+            if denom > 0.0:
+                offset = max(-0.5, min(0.5, 0.5 * (y0 - y2) / denom))
+        results.append(GlobalScaleSearchResult(
+            scale=max(scales[best] + offset * 0.075, 0.01),
+            mse=float(errors[best]),
+            evaluations=15,
+        ))
+    out: list[LayerQuantizationBasis] = []
+    for basis, result in zip(bases, results):
+        regularized = apply_global_scale(
+            RegularizedWeights(
+                inner=basis.target_inner,
+                suh=basis.suh,
+                svh=basis.svh,
+                stats=basis.stats,
+            ),
+            result,
+        )
+        stats = dict(regularized.stats)
+        stats["regularize_g_scale_skipped"] = False
+        out.append(
+            LayerQuantizationBasis(
+                source_public=basis.source_public,
+                target_inner=regularized.inner,
+                suh=regularized.suh,
+                svh=regularized.svh,
+                stats=stats,
+            )
+        )
+    return out
+
